#!name=WeRead 自动领取奖励
#!desc=定时（21:00）自动领取微信读书已达标阅读奖励（体验卡/书币）。基于协议层自动检测可领取奖励并一键领取
#!version=1.0.0
#!author=Codex
#!home=

[General]
bypass-tun = 0.0.0.0/0

[Argument]
# 奖励偏好: 开启=优先选书币, 关闭=优先选体验卡
prefer_coin=title=奖励选择, desc=开启：优先选书币 / 关闭：优先选体验卡, type=boolean, default=true

[Script]
# 捕获 Cookie：拦截 WeRead API 请求，保存认证凭证
http-request ^https?://i\.weread\.qq\.com/.* script-path=weread-auto-claim.js, tag=WeRead_CaptureCookie

# 定时任务：每晚 21:00 自动检查并领取
cron "0 21 * * *" script-path=weread-auto-claim.js, tag=WeRead_AutoClaim

[MITM]
hostname = i.weread.qq.com
