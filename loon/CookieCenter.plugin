#!name = CookieCenter · 统一凭据捕获
#!desc = 专职凭据捕获：一站式静默捕获微信读书(skey/vid)、山西电信(cookie/url)、翼支付等各平台鉴权凭证存入 BoxJS。日常签到与薅羊毛任务由 BoxJS 订阅统一调度。
#!author = TomCatXue
#!homepage = https://github.com/TomCatXue/MyCookieCenter
#!icon = https://avatars.githubusercontent.com/u/138953496?v=4
#!tag = Cookie,凭证捕获,BoxJS
#!version = 2.0.0
#!date = 2026-09-03

# =================== 独立开关 ===================

[Argument]
weread_capture = switch,true,tag=微信读书·凭据抓取,desc=打开微信读书App自动捕获vid/skey/Token
sx_benefit_capture = switch,true,tag=山西电信·凭证捕获,desc=进入电信AI福利H5自动捕获Cookie与活动链接
bestpay_capture = switch,true,tag=翼支付·一键收币签到,desc=打开翼支付赚钱专区页面自动一键收币与签到

# =================== MITM ===================

[MITM]
hostname = i.weread.qq.com, weread.qq.com, wx.sx.189.cn, render.bestpay.cn

# =================== 凭证捕获规则 ===================

[Script]
# --- 微信读书 (捕获 vid, skey, refreshToken, 翻牌状态) ---
http-request ^https?://i\.weread\.qq\.com/.* script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/app/weread_claim/weread_claim.js, tag=微信读书·凭据捕获, requires-body=false, enable={weread_capture}
http-request POST ^https?://i\.weread\.qq\.com/login script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/app/weread_claim/weread_claim.js, tag=微信读书·登录捕获, requires-body=true, enable={weread_capture}
http-response POST ^https?://i\.weread\.qq\.com/login script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/app/weread_claim/weread_claim.js, tag=微信读书·Token捕获, requires-body=true, enable={weread_capture}
http-request ^https?://weread\.qq\.com/.* script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/app/weread_claim/weread_claim.js, tag=微信读书·翻牌Cookie, requires-body=false, enable={weread_capture}

# --- 山西电信 · 体验AI领福利 (捕获活动 Cookie, ticket 与当期批次代码) ---
http-request ^https:\/\/wx\.sx\.189\.cn\/sx_ai_benefit\/h5\/HD script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/plugins/sx_ai_benefit/sx_ai_benefit.js, tag=山西电信·活动凭证捕获, requires-body=false, enable={sx_benefit_capture}

# --- 翼支付 · 权益币与绿色能量 (进入页面响应注入自动收币签到) ---
http-response ^https:\/\/render\.bestpay\.cn\/marketing-h5\/index\.html script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/plugins/bestpay_coin/bestpay_coin.js, tag=翼支付·收币签到注入, requires-body=true, enable={bestpay_capture}
http-request ^https:\/\/render\.bestpay\.cn\/__bestpay_notify__ script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/plugins/bestpay_coin/bestpay_coin.js, tag=翼支付·完成通知, requires-body=false, enable={bestpay_capture}


