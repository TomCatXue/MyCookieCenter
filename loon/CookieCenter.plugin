#!name = CookieCenter · Cookie 抓取合集
#!desc = 一键抓取 MyCookieCenter 维护的平台凭据（微信读书全业务凭据、山西电信、翼支付），每个应用一个独立开关（默认全关，按需打开）。仅含「抓取」规则，不含 cron 签到——签到任务由 BoxJs 订阅统一管理。打开对应开关后，进入相应 App 或网页触发即可，收到「✅ <名称> Cookie 获取成功」通知即成功。
#!author = TomCatXue
#!homepage = https://github.com/TomCatXue/MyCookieCenter
#!icon = https://avatars.githubusercontent.com/u/138953496?v=4
#!tag = 签到, Cookie, 凭据捕获
#!version = 3.1.0
#!date = 2026-09-05

# =================== 凭据抓取独立开关 (默认全关，按需开启) ===================

[Argument]
weread_capture = switch,false,tag=微信读书·全量凭据,desc=打开微信读书App、网页端或翻牌页，自动捕获各业务凭据与脱机换票Token
sx_benefit = switch,false,tag=山西电信·活动凭证,desc=进入电信AI领福利H5页面触发，抓取活动Cookie与链接
bestpay = switch,false,tag=翼支付·一键收币,desc=进入翼支付赚钱专区页面触发，自动秒收与签到

# =================== 抓取 / 注入规则 (无任何 Cron 任务) ===================

[Script]
# --- 1. 微信读书 · 全业务凭据捕获 (网页端 / 翻牌H5 / App常规API / 免费图书馆) ---
http-request ^https?:\/\/(i\.)?weread\.qq\.com\/(web\/|flip-card-game|user\/|feature|mobileSync|readdata\/|pay\/|free\/library|checkfreequalify) script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/app/weread_claim/weread_cookie.js, tag=微信读书·凭据捕获, requires-body=false, enable={weread_capture}

# --- 2. 微信读书 · App 登录与换票捕获 (获取 refreshToken/deviceId 激活全自动换票) ---
http-request POST ^https?:\/\/i\.weread\.qq\.com\/login script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/app/weread_claim/weread_cookie.js, tag=微信读书·登录请求, requires-body=true, enable={weread_capture}
http-response POST ^https?:\/\/i\.weread\.qq\.com\/login script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/app/weread_claim/weread_cookie.js, tag=微信读书·登录响应, requires-body=true, enable={weread_capture}

# --- 3. 山西电信 · 体验AI领福利活动凭据抓取 ---
http-request ^https:\/\/wx\.sx\.189\.cn\/sx_ai_benefit\/h5\/HD script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/plugins/sx_ai_benefit/sx_ai_benefit.js, tag=山西电信·活动凭证捕获, requires-body=false, enable={sx_benefit}

# --- 4. 翼支付 · 权益币与绿色能量 (进入页面响应注入自动秒收 + 完成通知) ---
http-response ^https:\/\/render\.bestpay\.cn\/marketing-h5\/index\.html script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/plugins/bestpay_coin/bestpay_coin.js, tag=翼支付·一键收币签到, requires-body=true, enable={bestpay}
http-request ^https:\/\/render\.bestpay\.cn\/__bestpay_notify__ script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/plugins/bestpay_coin/bestpay_coin.js, tag=翼支付·完成通知, requires-body=false, enable={bestpay}

# =================== MITM 解密域名 ===================

[MITM]
hostname = weread.qq.com, i.weread.qq.com, wx.sx.189.cn, render.bestpay.cn
