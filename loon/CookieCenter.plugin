#!name = CookieCenter · Cookie 抓取合集
#!desc = 一键抓取全部维护中业务的 Cookie 凭据（微信读书、中国电信全系、扫描全能王）。每个业务配备独立开关（默认全关，按需开启）。仅含「抓取」规则，不含任何定时签到执行——签到调度已全面收归青龙面板。
#!author = TomCatXue
#!homepage = https://github.com/TomCatXue/MyCookieCenter
#!icon = https://avatars.githubusercontent.com/u/138953496?v=4
#!tag = 签到, Cookie, 凭据捕获
#!version = 5.0.0
#!date = 2026-10-15 15:45

# =================== 1. 独立开关 (默认全关，按需开启) ===================

[Argument]
weread = switch,false,tag=微信读书,desc=抓取技巧：建议先进「我」的页面(抓App基础票据)，再去「周二翻牌」页(补齐Web完整票据)
telecom_draw = switch,false,tag=电信·会员抽奖,desc=打开微信小程序「中国电信5G会员/权益商城」触发，自动抓取 SessionKey 与手机号
telecom_rights = switch,false,tag=电信·等级权益,desc=打开电信营业厅 App 进「我的签到」或「等级权益」页面触发抓取
telecom_benefit = switch,false,tag=电信·山西福利,desc=打开山西电信体验AI领福利活动页面触发抓取最新批次凭证
camscanner = switch,false,tag=扫描全能王,desc=打开扫描全能王 App 进个人中心触发静默更新

# =================== 2. 纯抓取规则 (不含任何 cron 执行) ===================

[Script]
# --- 【微信读书】凭据捕获 (联动 weread 开关) ---
request if ${url} ~= /^https?:\/\/(i\.)?weread\.qq\.com\/(flip-card-game|user\/|feature|free\/library|checkfreequalify)/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/weread/weread_cookie.js?v=20261015") with enable=${weread}, tag="微信读书·凭据捕获", img-url="https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/icons/weread.png"
request if ${url} ~= /^https?:\/\/i\.weread\.qq\.com\/login/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/weread/weread_cookie.js?v=20261015") with enable=${weread}, tag="微信读书·登录请求", requires_body=true, img-url="https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/icons/weread.png"
response if ${url} ~= /^https?:\/\/i\.weread\.qq\.com\/login/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/weread/weread_cookie.js?v=20261015") with enable=${weread}, tag="微信读书·登录响应", requires_body=true, img-url="https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/icons/weread.png"

# --- 【中国电信·会员抽奖】凭据捕获 (联动 telecom_draw 开关) ---
request if ${url} ~= /^https?:\/\/cdn\.bestpay\.cn\/marketing\/telecom\.member\.config\.json/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/telecom/telecom_cookie.js?v=20261015") with enable=${telecom_draw}, tag="电信·会员配置捕获", img-url="https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/icons/189.png"
request if ${url} ~= /^https?:\/\/mapi-h5\.bestpay\.com\.cn\/gapi\/handyservice\/miniprogram\/checkParam/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/telecom/telecom_cookie.js?v=20261015") with enable=${telecom_draw}, tag="电信·小程序登录捕获", requires_body=true, img-url="https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/icons/189.png"
request if ${url} ~= /^https?:\/\/spanner\.bestpay\.com\.cn:10081/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/telecom/telecom_cookie.js?v=20261015") with enable=${telecom_draw}, tag="电信·MGS网关捕获", img-url="https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/icons/189.png"

# --- 【中国电信·等级权益】凭证捕获与回填 (联动 telecom_rights 开关) ---
request if ${url} ~= /^https?:\/\/(waphub|wappark)\.189\.cn\/(jt-sign|gateway|JinDouMall)\//i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/telecom/telecom_rights.js?v=20260912") with enable=${telecom_rights}, tag="电信·等级权益凭证捕获", img-url="https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/icons/189.png"
response if ${url} ~= /^https?:\/\/(waphub|wappark)\.189\.cn\/(jt-sign|gateway)\//i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/telecom/telecom_rights.js?v=20260912") with enable=${telecom_rights}, tag="电信·等级权益会话回填", requires_body=true, img-url="https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/icons/189.png"

# --- 【中国电信·山西福利】活动凭据捕获 (联动 telecom_benefit 开关) ---
request if ${url} ~= /^https:\/\/wx\.sx\.189\.cn\/sx_ai_benefit\/h5\/HD/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/telecom/telecom_benefit.js?v=20261015") with enable=${telecom_benefit}, tag="电信·山西活动凭证捕获", img-url="https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/icons/189.png"

# --- 【扫描全能王】用户凭证捕获 (联动 camscanner 开关) ---
request if ${url} ~= /^https:\/\/api-cs\.intsig\.net\/user\/cs\/get_user_attribute/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/tools/camscanner/camscanner.cookie.js?v=20260814-silent") with enable=${camscanner}, tag="扫描全能王 Cookie", img-url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/camscanner.png"

# =================== 3. MITM 解密域名 ===================

[MITM]
hostname = weread.qq.com, i.weread.qq.com, waphub.189.cn, wappark.189.cn, wx.sx.189.cn, mapi.bestpay.com.cn, mapi-h5.bestpay.com.cn, cdn.bestpay.cn, spanner.bestpay.com.cn, activity.bestpay.cn, h5.bestpay.cn, api-cs.intsig.net
