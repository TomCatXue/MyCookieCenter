#!name = CookieCenter · 统一凭据捕获
#!desc = 专职凭据捕获与页面处理：静默捕获微信读书(vid/skey/Token)、山西电信(Cookie/活动URL)，并完成翼支付页面权益秒收与签到，数据统一存入 BoxJS。定时任务由 BoxJS 订阅统一调度。
#!author = TomCatXue
#!homepage = https://github.com/TomCatXue/MyCookieCenter
#!icon = https://avatars.githubusercontent.com/u/138953496?v=4
#!tag = Cookie,凭据捕获,BoxJS
#!version = 2.2.0
#!date = 2026-09-03

# =================== 凭据捕获开关 ===================

[Argument]
# 各平台捕获 / 页面处理开关
weread_capture = switch,true,tag=微信读书·凭据捕获,desc=打开微信读书App自动捕获vid/skey/Token
sx_benefit_capture = switch,true,tag=山西电信·凭证捕获,desc=进入电信AI福利H5自动捕获Cookie与活动链接
bestpay_capture = switch,true,tag=翼支付·一键收币签到,desc=打开翼支付赚钱专区页面自动一键收币与签到

# =================== MITM 解密域名 ===================

[MITM]
hostname = i.weread.qq.com, weread.qq.com, wx.sx.189.cn, render.bestpay.cn

# =================== 捕获 / 注入规则 ===================

[Script]
# --- 1. 微信读书 (凭据捕获：vid/skey/Token/翻牌Cookie) ---
http-request ^https?://i\.weread\.qq\.com/.* script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/app/weread_claim/weread_claim.js, tag=微信读书·凭据捕获, requires-body=false, enable={weread_capture}
http-request POST ^https?://i\.weread\.qq\.com/login script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/app/weread_claim/weread_claim.js, tag=微信读书·登录捕获, requires-body=true, enable={weread_capture}
http-response POST ^https?://i\.weread\.qq\.com/login script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/app/weread_claim/weread_claim.js, tag=微信读书·Token捕获, requires-body=true, enable={weread_capture}
http-request ^https?://weread\.qq\.com/.* script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/app/weread_claim/weread_claim.js, tag=微信读书·翻牌Cookie, requires-body=false, enable={weread_capture}

# --- 2. 山西电信 · 体验AI领福利 (活动凭据捕获) ---
http-request ^https:\/\/wx\.sx\.189\.cn\/sx_ai_benefit\/h5\/HD script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/plugins/sx_ai_benefit/sx_ai_benefit.js, tag=山西电信·活动凭证捕获, requires-body=false, enable={sx_benefit_capture}

# --- 3. 翼支付 · 权益币与绿色能量 (进入页面响应注入自动秒收 + 完成通知) ---
http-response ^https:\/\/render\.bestpay\.cn\/marketing-h5\/index\.html script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/plugins/bestpay_coin/bestpay_coin.js, tag=翼支付·一键收币签到, requires-body=true, enable={bestpay_capture}
http-request ^https:\/\/render\.bestpay\.cn\/__bestpay_notify__ script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/plugins/bestpay_coin/bestpay_coin.js, tag=翼支付·完成通知, requires-body=false, enable={bestpay_capture}
