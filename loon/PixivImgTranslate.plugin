#!name = Pixiv · 漫画原位翻译
#!desc = 让 Pixiv App 原生阅读器直接显示中文译文：不需要打开额外查看器、不需要离开软件。\n• 拦截 i.pximg.net 图片请求，302 到图片翻译 Worker\n• Worker 侧调用视觉模型识别气泡、合成译文后回传图片\n• Pixiv 阅读器照常渲染，用户看到的就是汉化页\n• 翻译失败自动降级回原图，绝不影响正常阅读\n\n【使用前提】\n1. 部署 scripts/tools/pixiv/imgproxy 这个 Worker（见该目录 README）\n2. 把下面的 WORKER_HOST 改成你自己的 Worker 域名\n3. 装好本插件并开启 MITM，信任证书\n\n【验证步骤】\n先把 PASSTHROUGH 设为 1（只透传原图），打开 Pixiv 看漫画。\n如果图能正常显示 → 链路通，可以设回 0 开启翻译。\n如果图显示不出来 → Pixiv 不接受代理图片，需换方案。
#!author = TomCatXue
#!homepage = https://github.com/TomCatXue/MyCookieCenter
#!icon = https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/icons/pixiv.png
#!tag = Pixiv,翻译,漫画,汉化,原位
#!system = iOS,iPadOS
#!date = 2026-11-22 23:59
#!type = normal
#!version = 0.1.0

[Argument]
# ─────────────────────────────────────────────────────────────
# 把这里改成你部署好的 Worker 域名（不含 https:// 和路径）
# 例：pixiv-imgproxy.yourname.workers.dev
# ─────────────────────────────────────────────────────────────
WORKER_HOST = "pixiv-imgproxy.xuetom43b.workers.dev"

# 目标语言：zh-CN / zh-TW / en
TARGET_LANG = "zh-CN"

# 1 = 只透传原图（验证链路用）；0 = 开启翻译
PASSTHROUGH = "1"

# 是否翻译全部图片（1）还是只翻译漫画路径（0）
TRANSLATE_ALL = "0"

[Script]
# 图片请求改写：把 i.pximg.net 的请求转到翻译 Worker。
# 注意：这里用 http-request 脚本而非 URL Rewrite，
# 因为需要动态拼接 src 参数（原图完整 URL 要编码进查询串）。
http-request ^https:\/\/i\.pximg\.net\/(?:c\/|img-master\/|img-original\/|custom-thumb\/) script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/tools/pixiv/pixiv_imgproxy.js?v=81cdf183, requires-body=false, tag=Pixiv.ImgTranslate.Rewrite, argument={{{WORKER_HOST}}},{{{TARGET_LANG}}},{{{PASSTHROUGH}}},{{{TRANSLATE_ALL}}}

[MitM]
hostname = i.pximg.net
