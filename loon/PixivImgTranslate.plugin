#!name = Pixiv · 漫画原位翻译
#!desc = 让 Pixiv App 原生阅读器直接显示中文译文：不需要打开额外查看器、不需要离开软件。\n• 拦截 i.pximg.net 图片请求，转给自建翻译 Worker\n• Worker 侧调用视觉模型识别气泡、合成译文后回传图片\n• Pixiv 阅读器照常渲染，用户看到的就是汉化页\n• 翻译失败自动放行原图，绝不影响正常阅读
#!author = TomCatXue
#!homepage = https://github.com/TomCatXue/MyCookieCenter
#!icon = https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/icons/pixiv.png
#!tag = Pixiv,翻译,漫画,汉化,原位
#!system = iOS,iPadOS
#!date = 2026-11-22 23:59
#!type = normal
#!version = 0.2.0

[Argument]
WORKER_HOST = input,"pixiv.xuetom.top",tag=Worker 域名,desc=你的图片翻译 Worker 域名，不含 https:// 和路径
TARGET_LANG = input,"zh-CN",tag=目标语言,desc=zh-CN / zh-TW / en
PASSTHROUGH = switch,false,tag=透传模式,desc=开启时只透传原图（排查链路用）；关闭则正常翻译
TRANSLATE_ALL = switch,false,tag=翻译全部图片,desc=开启会连封面头像一起翻（更费钱更慢），一般保持关闭

[Script]
# 图片请求：脚本自己请求 Worker，拿到图片后直接返回给 App。
# 注意：Loon 的 request 脚本不支持 $done({ url }) 改写 URL，
# 那样写会被当成无效参数，Loon 直接返回 404。
request if ${url} ~= /^https:\/\/i\.pximg\.net\//i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/scripts/tools/pixiv/pixiv_imgproxy.js?v=192b741e", {${WORKER_HOST}, ${TARGET_LANG}, ${PASSTHROUGH}, ${TRANSLATE_ALL}}) with tag="Pixiv.漫画原位翻译", timeout=120

[MitM]
hostname = i.pximg.net
