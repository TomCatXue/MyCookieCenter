#!name = Pixiv · 漫画原位翻译
#!desc = 让 Pixiv App 原生阅读器直接显示中文译文：不需要打开额外查看器、不需要离开软件。\n• 拦截 i.pximg.net 图片请求，转到自建翻译 Worker\n• Worker 侧调用视觉模型识别气泡、合成译文后回传图片\n• Pixiv 阅读器照常渲染，用户看到的就是汉化页\n• 翻译失败自动降级回原图，绝不影响正常阅读
#!author = TomCatXue
#!homepage = https://github.com/TomCatXue/MyCookieCenter
#!icon = https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/icons/pixiv.png
#!tag = Pixiv,翻译,漫画,汉化,原位
#!system = iOS,iPadOS
#!date = 2026-11-22 23:59
#!type = normal
#!version = 0.1.1

[Argument]
WORKER_HOST = input,"pixiv-imgproxy.xuetom43b.workers.dev",tag=Worker 域名,desc=你的图片翻译 Worker 域名，不含 https:// 和路径
TARGET_LANG = input,"zh-CN",tag=目标语言,desc=zh-CN / zh-TW / en
PASSTHROUGH = switch,true,tag=透传模式,desc=开启时只透传原图（用于验证链路是否打通）；关闭则开启翻译
TRANSLATE_ALL = switch,false,tag=翻译全部图片,desc=开启会连封面头像一起翻（更费钱更慢），一般保持关闭

[Script]
# 图片请求改写：把 i.pximg.net 的图片请求转到翻译 Worker。
# 用 request 阶段脚本动态拼接 src 参数（原图完整 URL 要编码进查询串）。
request if ${url} ~= /^https:\/\/i\.pximg\.net\/(?:c\/|img-master\/|img-original\/|custom-thumb\/)/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/scripts/tools/pixiv/pixiv_imgproxy.js?v=b5f789f4", {${WORKER_HOST}, ${TARGET_LANG}, ${PASSTHROUGH}, ${TRANSLATE_ALL}}) with tag="Pixiv.漫画原位翻译", timeout=20

[MitM]
hostname = i.pximg.net
