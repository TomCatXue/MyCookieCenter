#!name = Pixiv · 漫画原位翻译
#!desc = 让 Pixiv App 原生阅读器直接显示中文译文：不需要打开额外查看器、不需要离开软件。\n• 用 Loon 原生 URL Rewrite 把 pximg 图片请求改道到自建 Worker\n• Worker 侧调用视觉模型识别气泡、合成译文后回传图片\n• Pixiv 阅读器照常渲染，用户看到的就是汉化页\n• 翻译失败自动降级回原图，绝不影响正常阅读
#!author = TomCatXue
#!homepage = https://github.com/TomCatXue/MyCookieCenter
#!icon = https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/icons/pixiv.png
#!tag = Pixiv,翻译,漫画,汉化,原位
#!system = iOS,iPadOS
#!date = 2026-11-22 23:59
#!type = normal
#!version = 0.3.1

[URL Rewrite]
# ────────────────────────────────────────────────────────────
# 把 i.pximg.net 的图片请求整体转到 Worker。
#
# Surge/Loon 的替换式重写：左边正则，右边目标，$1/$2 是捕获组。
# 注意：必须用空格分隔（不是 _ 也不是 ->）。
#
# 只改写漫画大图路径，头像和封面放行原站。
# ────────────────────────────────────────────────────────────
^https?:\/\/i\.pximg\.net\/(c\/[0-9]+x[0-9]+[^\/]*\/)?(img-master|img-original)\/(.*)$ https://pixiv.xuetom.top/$1$2/$3

[MitM]
hostname = i.pximg.net, pixiv.xuetom.top
