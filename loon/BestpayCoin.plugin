[MITM]
# 仅解密营销活动 H5 页面域名（绝不触碰客户端原生网关，杜绝证书错误）
hostname = render.bestpay.cn

[Script]
# 1. 页面自动化注入：进入“赚钱专区/绿色能量”页面瞬间，全自动一键收币与签到
http-response ^https:\/\/render\.bestpay\.cn\/marketing-h5\/index\.html script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/plugins/bestpay_coin/bestpay_coin.js?v=20260903-v1.3.0, requires-body=true, tag=翼支付·权益币秒刷, enable=true

# 2. 完成状态通知触发器：拦截前端完成信号推送 iOS 系统通知
http-request ^https:\/\/render\.bestpay\.cn\/__bestpay_notify__ script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/plugins/bestpay_coin/bestpay_coin.js?v=20260903-v1.3.0, requires-body=false, tag=翼支付·任务完成通知, enable=true
