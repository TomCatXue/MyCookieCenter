#!name = LoonMonitor · 小组件数据提供与状态服务
#!desc = 专为 iOS 哑巴面板 (MutePanel) 小组件打造的 Loon 本地监控数据服务。实时提供当前运行模式、策略组数量、活跃节点、VPN 出口 IP/归属地、延迟与订阅流量统计。
#!author = TomCatXue
#!homepage = https://github.com/TomCatXue/MyCookieCenter
#!icon = https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Loon.png
#!tag = Loon, 监控, 小组件, VPN
#!version = 1.4.0
#!date = 2026-10-12 23:35

# =================== 0. 参数配置 ===================
[Argument]
sub_url = input,"",tag=机场订阅链接,desc=配置机场节点订阅链接（URL），插件将自动定时同步上下行与剩余流量

# =================== 1. 本地解析 ===================
# 虚拟域名本身没有公网 DNS 记录，必须由 Loon 在本地解析，否则在 HTTP 代理
# 模式下会在 DNS 阶段就失败、请求根本进不到 Loon 的 HTTP 引擎。
[Host]
loon.box = 127.0.0.1
api.loon.box = 127.0.0.1
loon.local = 127.0.0.1

# =================== 2. 路由规则 ===================
# 兜底直连：即使脚本因故未命中，也不会被丢到远端节点上（历史上就是这样
# 撞到 TLS EOF 的）。同时保障出口探测平稳走代理。
[Rule]
DOMAIN,loon.box,DIRECT
DOMAIN,api.loon.box,DIRECT
DOMAIN,loon.local,DIRECT
DOMAIN-SUFFIX,ip-api.com,PROXY
DOMAIN-SUFFIX,ip.sb,PROXY

# =================== 3. 脚本拦截与服务 ===================
# 采用与本仓库其它已验证插件（CookieCenter / GitHubPushTime）一致的
# `request if ... then script(...) with ...` 写法，避免旧式 http-request
# 行在部分 Loon 版本上解析失败导致脚本静默失效。
#
# 脚本地址固定到 commit（而不是 @main）：jsDelivr 的 @main 别名在各边缘节点
# 上刷新不一致，实测会在数分钟内反复返回旧版脚本，导致「插件已更新但脚本
# 还是坏的」。commit 地址不可变，保证手机拿到的脚本与本插件严格配对。
# 以后升级脚本时，同步更新这里的 commit 与 #!version / #!date。
[Script]
# 1. 小组件数据服务：请求发出前直接短路返回 JSON（明文 HTTP，无需 MITM）
request if ${url} ~= /^https?:\/\/(api\.)?loon\.(box|local)(\/api)?\/monitor/i then script("https://cdn.jsdelivr.net/gh/TomCatXue/MyCookieCenter@d760af0/scripts/tools/loon/loon_monitor.js") with argument="${sub_url}", tag="Loon监控·小组件数据服务", timeout=10

# 2. 订阅流量静默捕获：只在疑似订阅地址上运行。
#    收窄匹配范围（路径段 subscription/subscribe，或带 token 查询参数），
#    避免每一条正文里恰好含这些词的响应都触发一次脚本。
response if ${url} ~= /\/(subscription|subscribe)|[?&]token=/i then script("https://cdn.jsdelivr.net/gh/TomCatXue/MyCookieCenter@d760af0/scripts/tools/loon/loon_monitor.js") with tag="Loon监控·订阅流量捕获", requires_body=false, timeout=10

# 3. 后台定时预热：每 2 小时定时唤醒同步出口 IP 与订阅流量，保证小组件 0ms 极速响应
cron "0 */2 * * *" then script("https://cdn.jsdelivr.net/gh/TomCatXue/MyCookieCenter@d760af0/scripts/tools/loon/loon_monitor.js") with argument="${sub_url}", tag="Loon监控·定时同步", timeout=20
