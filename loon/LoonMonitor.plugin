#!name = LoonMonitor · 小组件数据提供与状态服务
#!desc = 专为 iOS 哑巴面板 (MutePanel) 小组件打造的 Loon 本地监控数据服务。实时提供当前运行模式、策略组数量、活跃节点、VPN 出口 IP/归属地、延迟与订阅流量统计。
#!author = TomCatXue
#!homepage = https://github.com/TomCatXue/MyCookieCenter
#!icon = https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Loon.png
#!tag = Loon, 监控, 小组件, VPN
#!version = 1.4.4
#!date = 2026-10-13 14:30

# =================== 0. 参数配置 ===================
[Argument]
sub_url = input,"",tag=机场订阅链接,desc=配置机场节点订阅链接（URL），插件将自动定时同步上下行与剩余流量

# =================== 1. 本地解析 ===================
# 虚拟域名本身没有公网 DNS 记录，必须由 Loon 在本地解析。
# 注意：严禁解析到 127.0.0.1！iOS NetworkExtension 会将 127.0.0.1 视为系统
# 本地回环接口 (lo0) 导致流量根本不进 TUN 虚拟网卡，造成请求 RST 连接中断。
# 必须解析到 Fake-IP 保留网段 (198.18.0.1)，流量进入 TUN 即可触发 [Script] 短路。
[Host]
loon.box = 198.18.0.1
api.loon.box = 198.18.0.1
loon.local = 198.18.0.1

# =================== 2. 路由规则 ===================
# 兜底直连：即使脚本因故未命中，也不会被丢到远端节点上（历史上就是这样
# 撞到 TLS EOF 的）。同时保障出口探测平稳走代理。
[Rule]
# 显式将虚拟域名与 Fake-IP 绑定为 PROXY 策略：
# 1. 杜绝流量在全局直连或 FINAL DIRECT 模式下逃逸至物理网卡造成死锁超时；
# 2. 保证流量必定送入 Loon 代理栈以触发 [Script] 本地短路返回 Mock JSON；
# 3. 保证脚本拉取镜像 (fastly.jsdelivr.net / jsdelivr.net) 稳定可达。
DOMAIN,loon.box,PROXY
DOMAIN,api.loon.box,PROXY
DOMAIN,loon.local,PROXY
IP-CIDR,198.18.0.1/32,PROXY
DOMAIN-SUFFIX,jsdelivr.net,PROXY
DOMAIN-SUFFIX,ip-api.com,PROXY
DOMAIN-SUFFIX,ip.sb,PROXY


# =================== 3. 脚本拦截与服务 ===================
# 采用与 BoxJs 一致且经 Loon 官方各版本 (2.x ~ 3.x) 验证的经典 http-request / http-response 语法：
# 1. 杜绝声明式语法中由于 with argument 导致的语法解析异常；
# 2. 保证 $done({ response: {...} }) 在请求到达本地代理栈前完成 100% 短路 Mock 返回；
# 3. 脚本源迁移至国内稳定可达的 fastly.jsdelivr.net 不可变 commit 镜像，彻底解决 cdn.jsdelivr.net ECONNRESET 阻断。
[Script]
# 1. 小组件数据服务：请求发出前直接短路返回 JSON（标准 http-request 语法，全版本兼容短路 Mock）
http-request ^https?:\/\/((api\.)?loon\.(box|local)|198\.18\.0\.1)(:\d+)?\/.* script-path=https://fastly.jsdelivr.net/gh/TomCatXue/MyCookieCenter@5809d94/scripts/tools/loon/loon_monitor.js, timeout=10, argument="{sub_url}", tag=Loon监控·小组件数据服务

# 2. 订阅流量静默捕获：当 Loon 自身刷新机场订阅时自动截获并持久化剩余流量配额
http-response \/(subscription|subscribe)|[?&]token= script-path=https://fastly.jsdelivr.net/gh/TomCatXue/MyCookieCenter@5809d94/scripts/tools/loon/loon_monitor.js, requires-body=false, timeout=10, tag=Loon监控·订阅流量捕获

# 3. 后台定时预热：每 2 小时定时唤醒同步出口 IP 与订阅流量，保证小组件 0ms 极速响应
cron "0 */2 * * *" script-path=https://fastly.jsdelivr.net/gh/TomCatXue/MyCookieCenter@5809d94/scripts/tools/loon/loon_monitor.js, timeout=20, argument="{sub_url}", tag=Loon监控·定时同步


# =================== 4. MITM 解密 ===================
[MITM]
hostname = loon.box, api.loon.box, loon.local
