#!name = 移动爱家 · 全方位净化与纯净增强
#!desc = 彻底净化移动爱家/和家亲首页轮播、智能专区右上角广告与画布轮播大图/悬浮弹窗、发现页短视频/资讯文章流，以及我的钱包充话费下方轮播图、借钱、会员优享卡片与精彩推荐信息流。
#!openUrl = https://apps.apple.com/app/id583700738
#!author = TomCatXue
#!tag = 去广告, 移动爱家, 中国移动, 轮播净化
#!system = iOS,iPadOS
#!loon_version = 3.5.2(1005)
#!homepage = https://github.com/TomCatXue/MyCookieCenter
#!icon = https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/icons/10086.png
#!version = 1.0.0
#!date = 2026-10-23 02:00

[Argument]
HideCarousel = switch,true,tag=[轮播] 彻底移除轮播图,desc=移除首页与各专区横幅轮播图组件，使其彻底消失而非仅阻断跳转
HomeClean = switch,true,tag=[首页] 首页基础净化,desc=清理首页横幅轮播、XBYYW运营位广告、等级条营销与瀑布流
SmartPageClean = switch,true,tag=[智能] 移动爱家智能专区净化,desc=清理移动爱家/智能专区右上角广告、轮播大图、悬浮窗动效与营销触点弹窗
DiscoverClean = switch,true,tag=[发现] 发现页短视频与文章净化,desc=清空发现页短视频信息流、大轮播图与新闻资讯模块
WalletClean = switch,true,tag=[钱包] 充话费与钱包净化,desc=清理我的钱包中充话费下方轮播图、借钱、会员优享卡片与精彩推荐信息流
MineClean = switch,true,tag=[我的] 「我的」页面净化,desc=清理「我的」页面营销区域与推荐卡片

[Rule]
# APM 行为、性能监控、设备指纹与埋点日志上报拦截（底层物理级阻断，省电防追踪）
DOMAIN-SUFFIX, cmicapm.com, REJECT
DOMAIN-SUFFIX, dc.cmicapm.com, REJECT
DOMAIN-SUFFIX, jiguang.coc.10086.cn, REJECT
DOMAIN-SUFFIX, uba.cmft.com.cn, REJECT
DOMAIN-SUFFIX, yxfk.market.chinamobile.com, REJECT
DOMAIN-SUFFIX, uem.migu.cn, REJECT
DOMAIN-SUFFIX, da.mmarket.com, REJECT
DOMAIN-SUFFIX, dnlog.cmpassport.com, REJECT
DOMAIN-SUFFIX, log1.cmpassport.com, REJECT
DOMAIN-SUFFIX, dfp.cmft.com.cn, REJECT
DOMAIN-SUFFIX, mtm.online-cmcc.cn, REJECT
DOMAIN-SUFFIX, apm.app.coc.10086.cn, REJECT
DOMAIN-SUFFIX, apm.clientaccess.10086.cn, REJECT

[Rewrite]
# 开屏与基础广告规则秒拒拦截（零脚本开销）
request if ${url} ~= /^https?:\/\/(?:client\.app\.coc|app)\.10086\.cn\/biz-orange\/DN\/(?:explorePage\/getAdverList|init\/startInit|emotionMarket)(?:\?.*)?$/i then reject(200)
request if ${url} ~= /^https?:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/(?:DN\/(?:dropsAdverService\/getDropsAdverNew|homepagePopup\/getSortInfo|toast\/getToastRule|detainment\/august\/getPages)|DH\/(?:toast\/august\/(?:getToast|getPages)|message_query\/index\/getLatestPushMsg)|DA\/liveSuspension\/getPageCode|UN\/message\/pushMessage)(?:\?.*)?$/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/client\.app\.coc\.10086\.cn\/cache_server\/api\/cache\/encrypt\/reportV2(?:\?.*)?$/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/push\.it\.10086\.cn\/(?:contact\/(?:pull\/getUserActivityInfo|receipt\/activityReceipt)|mc\/pull\/pullDDpushMsgDetail)(?:\?.*)?$/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/app\.jf\.10086\.cn\/cmcc-h5-shop\/cms\/(?:advertisePosition|advertisePage)(?:\?.*)?$/i then reject_dict(200)
response if ${url} ~= /^https:\/\/ad\.mcloud\.139\.com\/advertapi\/adv-filter\/adv-filter\/AdInfoFilter\/getAdInfos(?:\?.*)?$/i && ${response.status} == 200 then response.json.jq(".body=[]")

[Script]
# 防304缓存穿透：请求阶段剥离 If-None-Match 与 If-Modified-Since，强制获取完整响应进行脚本清洗
request if ${url} ~= /^https:\/\/res\.coc\.10086\.cn\/res\/cdn\/coc1\/fixedPath\/production\.rightsmarket-h5-canvas\.online\.layout\..*\.json(?:\?.*)?$/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/cmcc/aijia_remove_ads.js?v=2026102301") with tag="[移动爱家]防304缓存穿透", timeout=5

# 移动爱家原生页面净化（首页顶部轮播图、标题栏右上角广告、我的页面营销）
response if ${url} ~= /^https:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/DN\/(?:homePage\/getTopAreaList|titleBar\/getIcon|myPageNew\/getMyPageNew)(?:\?.*)?$/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/cmcc/aijia_remove_ads.js?v=2026102301", {${HideCarousel}, ${HomeClean}, ${SmartPageClean}, ${MineClean}}) with tag="[移动爱家]原生页面与轮播净化", timeout=10, requires_body=true

# 我的钱包与充话费专区净化（清空充话费下方轮播图、端AI推荐、爆品必抢、会员优享卡片、猜你喜欢信息流与借钱吧贷款卡片）
response if ${url} ~= /^https:\/\/app\.jf\.10086\.cn\/cmcc-h5-shop\/(?:cms\/(?:contents|yourFavorite)|hePay\/all)(?:\?.*)?$/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/cmcc/aijia_remove_ads.js?v=2026102301", {${WalletClean}, ${HideCarousel}}) with tag="[移动爱家]我的钱包与充话费净化", timeout=10, requires_body=true

# 发现页短视频、大轮播图与新闻资讯文章流净化
response if ${url} ~= /^https?:\/\/display-sc\.miguvideo\.com\/display\/v3\/static(?:\/.*)?$/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/cmcc/aijia_remove_ads.js?v=2026102301", {${DiscoverClean}, ${HideCarousel}}) with tag="[移动爱家]发现页视频与文章净化", timeout=10, requires_body=true

# 移动爱家与智能专区画布布局净化（剔除轮播图 Swiper、排行榜大图、悬浮窗动效与营销触点弹窗）
response if ${url} ~= /^https:\/\/res\.coc\.10086\.cn\/res\/cdn\/coc1\/fixedPath\/production\.rightsmarket-h5-canvas\.online\.layout\..*\.json(?:\?.*)?$/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/cmcc/aijia_remove_ads.js?v=2026102301", {${SmartPageClean}, ${HideCarousel}}) with tag="[移动爱家]智能专区与爱家画布净化", timeout=10, requires_body=true

[MITM]
hostname = client.app.coc.10086.cn, h.app.coc.10086.cn, app.10086.cn, app.jf.10086.cn, display-sc.miguvideo.com, res.coc.10086.cn, push.it.10086.cn, ad.mcloud.139.com
