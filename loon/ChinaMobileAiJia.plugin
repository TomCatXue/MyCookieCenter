#!name = 移动爱家
#!desc = 净化首页轮播、智能专区、短视频和钱包营销推荐。
#!openUrl = https://apps.apple.com/app/id1147452377
#!author = TomCatXue
#!tag = 去广告, 移动爱家, 中国移动, 轮播净化
#!system = iOS,iPadOS
#!loon_version = 3.5.2(1005)
#!homepage = https://github.com/TomCatXue/MyCookieCenter
#!icon = https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/41/57/e5/4157e52f-d849-d15f-d210-d7bf93c7129e/AppIcon-0-0-1x_U007emarketing-0-6-0-sRGB-85-220.png/512x512bb.jpg
#!version = 1.1.4
#!date = 2026-10-24 14:43

[Argument]
HideCarousel = switch,true,tag=[轮播] 彻底移除轮播图,desc=移除首页与各专区横幅轮播图组件，使其彻底消失而非仅阻断跳转
LaunchAdClean = switch,true,tag=[开屏] 启动广告净化,desc=清理友盟 U-Push 启动广告与本地缓存下发的开屏素材
HomeClean = switch,true,tag=[首页] 首页基础净化,desc=清理首页横幅轮播、XBYYW运营位广告、等级条营销与瀑布流
SmartPageClean = switch,true,tag=[智能] 移动爱家智能专区净化,desc=清理移动爱家/智能专区右上角广告、轮播大图、悬浮窗动效与营销触点弹窗
DiscoverClean = switch,true,tag=[发现] 发现页短视频与文章净化,desc=清空发现页短视频信息流、大轮播图与新闻资讯模块
WalletClean = switch,true,tag=[钱包] 充话费与钱包净化,desc=清理我的钱包中充话费下方轮播图、借钱、会员优享卡片与精彩推荐信息流
MineClean = switch,true,tag=[我的] 「我的」页面净化,desc=清理「我的」页面营销区域与推荐卡片

[Rule]
# APM 行为、性能监控、设备指纹与埋点日志上报拦截（底层物理级阻断，省电防追踪）
DOMAIN-SUFFIX, cmicapm.com, REJECT
DOMAIN-SUFFIX, dc.cmicapm.com, REJECT
DOMAIN-SUFFIX, uba.cmft.com.cn, REJECT
DOMAIN-SUFFIX, yxfk.market.chinamobile.com, REJECT
DOMAIN-SUFFIX, uem.migu.cn, REJECT
DOMAIN-SUFFIX, da.mmarket.com, REJECT
DOMAIN-SUFFIX, dfp.cmft.com.cn, REJECT
DOMAIN-SUFFIX, mtm.online-cmcc.cn, REJECT
# 移动爱家(和家亲)用户行为全链路追踪与营销平台
DOMAIN-SUFFIX, trace.hjq.komect.com, REJECT
DOMAIN-SUFFIX, event.video.komect.com, REJECT
DOMAIN-SUFFIX, aishop.vis.komect.com, REJECT
# 第三方广告 SDK 与咪咕广告投放端点
DOMAIN-SUFFIX, ggc.cmvideo.cn, REJECT
DOMAIN-SUFFIX, adxserver.ad.cmvideo.cn, REJECT
DOMAIN-SUFFIX, ggadjust.cmvideo.cn, REJECT
DOMAIN-SUFFIX, gdt.qq.com, REJECT
DOMAIN-SUFFIX, e.qq.com, REJECT

[Rewrite]
# 移动爱家商城降价气泡浮窗与轻量推荐秒拒
request if ${url} ~= /^https?:\/\/shop\.hjq\.komect\.com\/hjqmall\/(?:goods\/(?:price\/reduction\/bubble|recommend\/light))(?:\?.*)?$/i then reject_dict(200)

# 友盟 U-Push 启动广告：仅拦启动广告接口，不影响普通推送通道
request if ${url} ~= /^https?:\/\/(?:ulogs\.umeng\.com|ulogs\.umengcloud\.com|msg\.umengcloud\.com)\/admsg\/v2\/launch(?:\?.*)?$/i then reject_dict(200)

[Script]
# 和包/我的钱包充话费营销净化（轮播图、弹窗、悬浮窗、借钱与会员优享卡片、精彩推荐信息流、页面广告位）
response if ${url} ~= /^https?:\/\/p\.10086\.cn\/wap\/v1\/(?:polymeriza-page\/(?:banner|popup|activity|business|group-cards|marquee)|float\/window|guess\/shop)(?:\?.*)?$/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/cmcc/aijia_remove_ads.js?v=2026102403", {${WalletClean}, ${HideCarousel}}) with tag="[移动爱家]和包充话费营销净化", requires_body=true

# 防304缓存穿透：请求阶段剥离 If-None-Match 与 If-Modified-Since，强制获取完整响应进行脚本清洗
request if ${url} ~= /^https:\/\/res\.coc\.10086\.cn\/res\/cdn\/coc1\/fixedPath\/production\.rightsmarket-h5-canvas\.online\.layout\..*\.json(?:\?.*)?$/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/cmcc/aijia_remove_ads.js?v=2026102403", {${WalletClean}, ${HideCarousel}}) with tag="[移动爱家]防304缓存穿透", timeout=5

# 发现页短视频、大轮播图与新闻资讯文章流净化
response if ${url} ~= /^https?:\/\/display-sc\.miguvideo\.com\/display\/v3\/static(?:\/.*)?$/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/cmcc/aijia_remove_ads.js?v=2026102403", {${DiscoverClean}, ${HideCarousel}}) with tag="[移动爱家]发现页视频与文章净化", timeout=10, requires_body=true

# 移动爱家与智能专区画布布局净化（剔除轮播图 Swiper、排行榜大图、悬浮窗动效与营销触点弹窗）
response if ${url} ~= /^https:\/\/res\.coc\.10086\.cn\/res\/cdn\/coc1\/fixedPath\/production\.rightsmarket-h5-canvas\.online\.layout\..*\.json(?:\?.*)?$/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/cmcc/aijia_remove_ads.js?v=2026102403", {${SmartPageClean}, ${HideCarousel}}) with tag="[移动爱家]智能专区与爱家画布净化", timeout=10, requires_body=true


# 移动爱家商城首页布局净化（保留Icon功能入口，移除视频/引流专区与瀑布流）
response if ${url} ~= /^https?:\/\/shop\.hjq\.komect\.com\/hjqmall\/layout\/index\/(?:content|frame)(?:\?.*)?$/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/cmcc/aijia_remove_ads.js?v=2026102403", {${HomeClean}, ${HideCarousel}}) with tag="[移动爱家]商城楼层净化", timeout=10, requires_body=true

# 和家亲原生首页 Banner 净化
response if ${url} ~= /^https?:\/\/base\.hjq\.komect\.com\/(?:(?:base|keel)\/)?idx\/(?:getBannerContentList|getTabBannerList)(?:[\/?].*)?$/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/cmcc/aijia_remove_ads.js?v=2026102403", {${HideCarousel}, ${HomeClean}}) with tag="[移动爱家]和家亲首页Banner与楼层净化", timeout=10, requires_body=true
response if ${url} ~= /^https?:\/\/base\.hjq\.komect\.com\/hjq-prov\/api\/provApply\/homepage\/getBannerList(?:\?.*)?$/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/cmcc/aijia_remove_ads.js?v=2026102403", {${HideCarousel}, ${HomeClean}}) with tag="[移动爱家]和家亲设备与省份Banner净化", timeout=10, requires_body=true


# 移动爱家智能专区与场景推荐轮播/模板净化（清理智能页面右侧轮播与推荐卡片）
response if ${url} ~= /^https?:\/\/base\.hjq\.komect\.com\/(?:base\/)?scene\/(?:getRuleTemplates|getRecommendRules)(?:\?.*)?$/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/cmcc/aijia_remove_ads.js?v=2026102403", {${SmartPageClean}, ${HideCarousel}}) with tag="[移动爱家]智能专区场景轮播净化", timeout=10, requires_body=true

[MITM]
hostname = p.10086.cn, shop.hjq.komect.com, base.hjq.komect.com, display-sc.miguvideo.com, res.coc.10086.cn, ulogs.umeng.com, ulogs.umengcloud.com, msg.umengcloud.com
