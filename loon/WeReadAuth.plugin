#!name = 微信读书凭据获取
#!desc = 打开微信读书 App 与活动页自动捕获 App / Web 票据，写入 weread_auth，并可经取凭证网关同步呆呆面板。
#!author = TomCatXue
#!homepage = https://github.com/TomCatXue/MyCookieCenter
#!icon = https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/icons/weread.png
#!tag = Cookie, 凭据捕获, 微信读书
#!version = 1.0.0
#!date = 2026-11-14 16:46

[Argument]
capture = switch,false,tag=票据捕获,desc=打开后进入微信读书「我」或「翻牌/限免」页面自动抓取，抓取完成后建议关闭

[Script]
request if ${url} ~= /^https?:\/\/(i\.)?weread\.qq\.com\/(flip-card-game|user\/|feature|free\/library|checkfreequalify|login)/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/weread/weread_cookie.js?v=7a55ec4b") with enable=${capture}, tag="微信读书·凭据捕获", requires_body=true, img_url="https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/icons/weread.png"
response if ${url} ~= /^https?:\/\/i\.weread\.qq\.com\/login/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/weread/weread_cookie.js?v=7a55ec4b") with enable=${capture}, tag="微信读书·登录回填", requires_body=true, img_url="https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/icons/weread.png"

[MITM]
hostname = weread.qq.com, i.weread.qq.com
