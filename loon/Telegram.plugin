#!name = Telegram增强
#!desc = 将Telegram的垃圾IP转移到优质IP上减少转圈加载；支持外部 t.me 链接自动唤醒跳转至第三方客户端。
#!openUrl = https://apps.apple.com/app/id686449807
#!author = chaoscard (原作), sooyaaabo, Repcz / TomCatXue
#!homepage = https://github.com/TomCatXue/MyCookieCenter
#!icon = https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/icons/telegram.png
#!tag = Telegram,功能增强,分流优化
#!version = 1.0.0
#!date = 2026-11-01 12:48

[Argument]
t.me_redirect = select, "Telegram", "Swiftgram", "Turrit", "iMe", "Nicegram", "Lingogram", tag=跳转至对应客户端, desc=选择点击t.me链接时唤起的目标客户端

[Host]
