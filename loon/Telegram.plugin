#!name = Telegram增强
#!desc = 将Telegram的垃圾IP转移到优质IP上减少转圈加载；全量高精度拦截外部 t.me / telegram.me / telegram.dog 链接，支持直接唤醒跳转至官方或任意第三方客户端（消息贴文、群组频道邀请、Bot、MiniApp、代理、贴纸全兼容）。
#!openUrl = https://apps.apple.com/app/id686449807
#!author = chaoscard (原作), sooyaaabo, Repcz / TomCatXue
#!homepage = https://github.com/TomCatXue/MyCookieCenter
#!icon = https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/icons/telegram.png
#!tag = Telegram,功能增强,分流优化
#!version = 1.1.0
#!date = 2026-11-01 13:10

[Argument]
t.me_redirect = select, "Telegram", "Swiftgram", "Nagram", "Turrit", "iMe", "Nicegram", "Lingogram", "Teleplus", tag=跳转至对应客户端, desc=选择点击t.me链接时唤起的目标客户端

