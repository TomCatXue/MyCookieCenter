#!name = QQ空间广告屏蔽
#!desc = 广告退散，空间清净
#!author = zqzess / TomCatXue
#!homepage = https://github.com/TomCatXue/MyCookieCenter
#!icon = https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/icons/qzone.jpg
#!tag = QQ空间,广告屏蔽,清净浏览
#!version = 1.1.0
#!date = 2026-09-19 12:00

# 域名规则 — 直接 REJECT
[Rule]
DOMAIN,d3g.qq.com,REJECT
DOMAIN,bsrv.qq.com,REJECT
DOMAIN,sq.bls.mdt.qq.com,REJECT
DOMAIN,adsmind.gdtimg.com,REJECT
DOMAIN,xj-landing.gdtimg.com,REJECT

# 复写规则 — 将广告请求拒绝拦截 (匹配 http/https)
[Rewrite]
request if ${url} ~= /^https?:\/\/c\.gdt\.qq\.com\/gdt_clickwap\.fcg\?viewid/i then reject(404)
request if ${url} ~= /^https?:\/\/pgdt\.gtimg\.cn\/gdt\/0\/.*\.jpg/i then reject(404)
request if ${url} ~= /^https?:\/\/v\.gdt\.qq\.com\/gdt_stats\.fcg\?viewid/i then reject(404)
request if ${url} ~= /^https?:\/\/rpt\.gdt\.qq\.com\/creative_view\?viewid/i then reject(404)
request if ${url} ~= /^https?:\/\/pgdt\.gtimg\.cn\/gdt\/.*\.png/i then reject(404)
request if ${url} ~= /^https?:\/\/pgdt\.gtimg\.cn\/gdt\/.*\.jpg/i then reject(404)
request if ${url} ~= /^https?:\/\/pgdt\.gtimg\.cn\/.*\/snscosdownload\/SH\/reserved\/.*/i then reject(404)
