#!name = 番茄小说 · 极简去广告
#!desc = 移除番茄小说（DragonRead）全场景广告与多余营销：\n• 开屏广告与实时库存秒回空字典，消除启动卡顿\n• 移除章节底部、章末广告位、商业化混排及阅读内插页广告\n• 激活官方原生免广告特权通道，保留最舒适的小说排版\n• 移除阅读器悬浮活动部件、存钱罐小猪/计时器金币挂件及激励视频弹窗\n• 过滤底栏多余福利/赚钱 Tab，恢复清爽纯净布局\n• 阻断 QUIC/TNC 绕过，穿山甲 SDK 控频截断，全面封锁日志与数据上报\n分层拦截架构，0 多余沙箱开销，畅享极简纯净阅读。
#!author = TomCatXue
#!homepage = https://github.com/TomCatXue/MyCookieCenter
#!icon = https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/DragonRead.png
#!system = iOS,iPadOS,macOS
#!system_version = 15.0
#!loon_version = 3.5.1(988)
#!tag = 去广告,番茄小说,体验优化,工具
#!version = 1.0.4
#!date = 2026-10-06 13:10

[Rule]
# 1. 核心白名单：用户中心与音频流直连放行，防止登录态失效与听书异常
DOMAIN, ecomuser.snssdk.com, DIRECT
AND, ((DOMAIN-SUFFIX, fqnovelvod.com), (DOMAIN-KEYWORD, tts)), DIRECT

# 2. 阻断 QUIC (HTTP/3) 与 HTTPDNS UDP 探测，强制客户端降级至 TCP 走代理与 MitM
AND, ((PROTOCOL, UDP), (DEST-PORT, 443)), REJECT
AND, ((PROTOCOL, UDP), (DEST-PORT, 6443)), REJECT

# 3. 拦截 TNC (HTTPDNS 调度器)，阻止客户端通过 TNC 获取直连 IP 绕过域名规则
AND, ((DOMAIN-KEYWORD, tnc), (AND, ((OR, ((DOMAIN-KEYWORD, -bjlgy), (DOMAIN-KEYWORD, -alisc), (DOMAIN-KEYWORD, -aliec), (DOMAIN-KEYWORD, -alisg))), (OR, ((DOMAIN-SUFFIX, snssdk.com), (DOMAIN-SUFFIX, isnssdk.com), (DOMAIN-SUFFIX, toutiaoapi.com), (DOMAIN-SUFFIX, bytedance.com), (DOMAIN-SUFFIX, zijieapi.com)))))), REJECT
DOMAIN, tnc3-alisc1.zijieapi.com, REJECT
DOMAIN, tnc3-aliec2.snssdk.com, REJECT
DOMAIN, tnc3-alisc1.snssdk.com, REJECT
DOMAIN, tnc3-bjlgy.snssdk.com, REJECT

# 4. 放行穿山甲广告请求至 Script 阶段进行 20001 控频截断 (防止直接 REJECT 触发轮询与本地缓存)
URL-REGEX, ^https:\/\/api-access\.pangolin-sdk-toutiao(\d|-b)?\.com\/api\/ad\/, DIRECT

# 5. 穿山甲 / 巨量广告联盟其他域名与 SDK 静态资源
DOMAIN-SUFFIX, pangolin-sdk-toutiao.com, REJECT
DOMAIN-SUFFIX, pglstatp-toutiao.com, REJECT
DOMAIN-SUFFIX, pangle.io, REJECT
DOMAIN-SUFFIX, sgsnssdk.com, REJECT
DOMAIN-SUFFIX, byteactivity.com, REJECT
DOMAIN-SUFFIX, toutiaocloud.com, REJECT
DOMAIN-SUFFIX, toutiaocloud.net, REJECT
DOMAIN-SUFFIX, bytedcdn.com, REJECT
DOMAIN, zlink.ugsdk.cn, REJECT
DOMAIN, dig.bdurl.net, REJECT
DOMAIN, dig.zjurl.cn, REJECT

# 6. 广告离线包平台 Gecko 与 Lottie 悬浮挂件 CDN（彻底阻断存钱罐小猪/金币挂件下载）
DOMAIN-SUFFIX, bytegecko.com, REJECT
DOMAIN-SUFFIX, bytegoofy.com, REJECT
DOMAIN-SUFFIX, byteorge.com, REJECT
DOMAIN, gecko.zijieapi.com, REJECT
DOMAIN, gecko3.zijieapi.com, REJECT
DOMAIN, gecko5.zijieapi.com, REJECT
DOMAIN-KEYWORD, gecko.zijieapi.com, REJECT

# 7. 广告分发、追踪与分析
DOMAIN-KEYWORD, -ad-sign.byteimg.com, REJECT
DOMAIN-KEYWORD, -ad-sign.fqnovelpic.com, REJECT
DOMAIN-KEYWORD, -applog.fqnovel.com, REJECT
DOMAIN-KEYWORD, rtlog, REJECT
DOMAIN-KEYWORD, mon11-misc, REJECT
DOMAIN-KEYWORD, mon3-misc, REJECT
DOMAIN, api5-normal-sinfonlinec.fqnovel.com, REJECT
DOMAIN, ads.toutiao.com, REJECT
DOMAIN, ad.toutiao.com, REJECT
DOMAIN, ad.zijieapi.com, REJECT
DOMAIN, ads3-normal.zijieapi.com, REJECT
DOMAIN, ads5-normal.zijieapi.com, REJECT
DOMAIN, abtest3-misc.zijieapi.com, REJECT
DOMAIN, mssdk.zijieapi.com, REJECT
DOMAIN, mssdk-bu.bytedance.com, REJECT
DOMAIN, mssdk.volces.com, REJECT
DOMAIN, feedback-c.zijieapi.com, REJECT
DOMAIN, minigame3-normal.zijieapi.com, REJECT
DOMAIN, minigame5-normal.zijieapi.com, REJECT
DOMAIN, timon.zijieapi.com, REJECT
DOMAIN, vcs.zijieapi.com, REJECT
DOMAIN, vas.snssdk.com, REJECT
DOMAIN, security.snssdk.com, REJECT
DOMAIN, bds.snssdk.com, REJECT
DOMAIN, log.snssdk.com, REJECT
DOMAIN, extlog.snssdk.com, REJECT
DOMAIN, toblog.ctobsnssdk.com, REJECT
DOMAIN, lf-ad-ies.bytecdn.cn, REJECT
DOMAIN, p3-developer.bytemaimg.com, REJECT
DOMAIN, webcast-open.douyin.com, REJECT
DOMAIN, p11-webcast-sign.douyinpic.com, REJECT
DOMAIN, p3-webcast-sign.douyinpic.com, REJECT

[URL Rewrite]
# 开屏启动广告配置与实时库存请求（内核直接秒回空字典，消除启动黑屏与跳过等待）
^https?:\/\/(?:[^\/]+\.)?fqnovel\.com\/api\/ad\/splash\/ reject-dict
^https?:\/\/(?:[^\/]+\.)?fqnovel\.com\/api\/ad\/v\d\/splash\/ reject-dict
^https?:\/\/(?:[^\/]+\.)?fqnovel\.com\/api\/ad\/splash\/novelapp\/ reject-dict
^https?:\/\/(?:[^\/]+\.)?fqnovel\.com\/api\/ad\/splash\/stock\/ reject-dict

# 章节末尾广告资源位与商业化混排（阅读翻页时不唤醒 JS 引擎，内核秒回）
^https?:\/\/(?:[^\/]+\.)?fqnovel\.com\/reading\/commerceapi\/chapter_end\/resource\/ reject-dict
^https?:\/\/(?:[^\/]+\.)?fqnovel\.com\/reading\/commerceapi\/ad\/ reject-dict
^https?:\/\/(?:[^\/]+\.)?fqnovel\.com\/reading\/commerceapi\/commerce\/tab\/ reject-dict
^https?:\/\/(?:[^\/]+\.)?fqnovel\.com\/reading\/bookapi\/commerce\/tag_info reject-dict

# 通用广告聚合接口与穿山甲 SDK 广告下发
^https?:\/\/(?:[^\/]+\.)?fqnovel\.com\/api\/ad\/v\d\/(?:aggregate|banner|inspire|dislike|report|live_cmm) reject-dict
^https?:\/\/(?:[^\/]+\.)?fqnovel\.com\/api\/ad\/union\/sdk\/get_ads reject-dict

# 激励视频弹窗与再领提示
^https?:\/\/(?:[^\/]+\.)?fqnovel\.com\/polaris\/task\/incentive_ad_again_info reject-dict

# PCDN 与客户端遥测配置
^https?:\/\/is\.snssdk\.com\/service\/settings\/ reject-dict

# 字节静态图文广告素材与动态广告离线包拦截
^https?:\/\/[^\/]+\.pstatp\.com\/(?:obj|img)\/(?:ad-app-package|ad|web\.business\.image) reject-200
^https?:\/\/[^\/]+\.pstatp\.com\/bytecom\/resource\/track_log\/src\/ reject-200
^https?:\/\/[^\/]+\.pglstatp-toutiao\.com\/obj\/(?:ad-pattern|ad-app-package)\/ reject-200
^https?:\/\/[^\/]+\.byteimg\.com\/(?:ad-app-package|web\.business\.image) reject-200
^https?:\/\/[^\/]+\.bytegecko\.com\/.* reject-200
^https?:\/\/gurd\.snssdk\.com\/src\/server\/v\d\/package reject-dict
^https?:\/\/lf-cdn-tos\.bytescm\.com\/obj\/static\/ad\/ reject-200
^https?:\/\/tnc3-alisc1\.zijieapi\.com\/get_domains\/ reject

[MITM]
hostname = api5-normal-lf.fqnovel.com, api5-normal-c-lq.fqnovel.com, api5-normal-c-hl.fqnovel.com, api3-normal-c-lq.fqnovel.com, api5-normal.fqnovel.com, api-normal.fqnovel.com, api.fqnovel.com, *.fqnovel.com, api-access.pangolin-sdk-toutiao*.com, sf*-fe-tos.pglstatp-toutiao.com, tnc3-alisc1.zijieapi.com, lf-cdn-tos.bytescm.com, is.snssdk.com, *.bytegecko.com, gecko.zijieapi.com

[Script]
# 1. 穿山甲 / 广告联盟 SDK 官方控频状态伪造 (status_code: 20001, reason: 112 彻底关闭广告位，防止轮询重试)
response if ${url} ~= /^https?:\/\/(?:api-access\.pangolin-sdk-toutiao(?:\d|-b)?|is\.snssdk)\.com\/api\/ad\/union\/sdk\/get_ads/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/tools/dragonread/dragonread_adblock.js?v=20261006-1310") with tag="番茄小说·穿山甲控频", requires_body=true

# 2. 官方标准 Script v2 语法：激活官方原生免广告特权通道、注入 VIP 个人中心徽章、正文广告兜底清洗、精简底栏福利 Tab
response if ${url} ~= /^https?:\/\/(?:api\d?-normal[^/]*|[^/]+)\.fqnovel\.com\/(?:api\/novel\/(?:account\/v\d\/vip\/info|book\/reader\/content|trade\/vip)|reading\/(?:user\/(?:info|profile|basic_info)|reader\/(?:full|batch_full)|chapter|content|flow|bookapi\/(?:bookmall\/tab|my_tab)|commerceapi)|openapi\/setting\/tab|luckycat|usercenter)/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/tools/dragonread/dragonread_adblock.js?v=20261006-1310") with tag="番茄小说·极简去广告", requires_body=true
