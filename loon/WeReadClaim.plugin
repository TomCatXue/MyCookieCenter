#!name = 微信读书自动领取奖励
#!desc = 定时（21:00）自动领取已达标阅读时长奖励（书币/体验卡），可通过插件开关切换偏好
#!author = Codex
#!homepage = https://github.com/TomCatXue/MyCookieCenter
#!icon = https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/icons/weread.png
#!tag = 微信读书,自动领取,阅读奖励

[Argument]
# 奖励偏好: 开=优先选书币, 关=优先选体验卡
prefer_coin = switch,true,tag=奖励选择,desc=开启：优先选书币 / 关闭：优先选体验卡

[MITM]
hostname = i.weread.qq.com

[Script]
# === Cookie 捕获（内嵌脚本，无需外部文件，保证即时生效）===
http-request ^https?://i\.weread\.qq\.com/.* script-path=script-, tag=WeReadClaim Cookie, enable=true

# === 定时领取（引用外部 JS，需推送至 GitHub 后生效）===
cron "0 21 * * *" script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/plugins/weread_claim/weread_claim.js, tag=WeReadClaim 签到, enable=true
