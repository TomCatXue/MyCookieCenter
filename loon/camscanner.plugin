#!name = 扫描全能王
#!desc = 抓取 Cookie + 每日签到
#!author = MaYIHEI (原作) / TomCatXue
#!homepage = https://github.com/TomCatXue/MyCookieCenter
#!icon = https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/26/ff/f2/26fff2c0-729b-5216-0c13-7d0499f10940/AppIconLite-0-0-1x_U007ephone-0-6-0-0-sRGB-85-220.png/512x512bb.jpg
#!tag = 扫描全能王,Cookie,签到
#!version = 1.3.0
#!date = 2026-09-19 12:30

# =================== 独立开关 ===================

[Argument]
cookie_capture = switch,true,tag=抓取Cookie,desc=打开扫描全能王触发用户属性接口抓取Cookie
sign_in = switch,true,tag=每日签到,desc=每天10:15自动签到

# =================== MITM ===================

[MITM]
hostname = api-cs.intsig.net

# =================== 脚本规则 ===================

[Script]
# 抓取 Cookie：打开扫描全能王 → 触发用户属性接口 → 静默更新（不弹通知，失效由签到通知）
request if ${url} ~= /^https:\/\/api-cs\.intsig\.net\/user\/cs\/get_user_attribute/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/scripts/tools/camscanner/camscanner.cookie.js?v=20260814-silent") with enable=${cookie_capture}, tag="扫描全能王 Cookie", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/camscanner.png"

# 每日签到：每天 10:15 自动执行
cron "15 8 * * *" then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/camscanner/camscanner.js") with tag="扫描全能王签到", img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/camscanner.png"
