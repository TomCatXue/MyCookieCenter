#!name = 扫描全能王
#!desc = 抓取 Cookie + 每日签到
#!author = MaYIHEI (原作) / TomCatXue
#!homepage = https://github.com/TomCatXue/MyCookieCenter
#!icon = https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/camscanner.png
#!tag = 扫描全能王,Cookie,签到

# =================== 独立开关 ===================

[Argument]
cookie_capture = switch,true,tag=抓取Cookie,desc=打开扫描全能王触发用户属性接口抓取Cookie
sign_in = switch,true,tag=每日签到,desc=每天10:15自动签到

# =================== MITM ===================

[MITM]
hostname = api-cs.intsig.net

# =================== 脚本规则 ===================

[Script]
# 抓取 Cookie：打开扫描全能王 → 触发用户属性接口 → 静默更新（不弹通知，失效由签到通知）
http-request ^https:\/\/api-cs\.intsig\.net\/user\/cs\/get_user_attribute tag=扫描全能王 Cookie, script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/plugins/camscanner/camscanner.cookie.js?v=20260814-silent, requires-body=false, img-url=https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/camscanner.png, enable={cookie_capture}

# 每日签到：每天 10:15 自动执行
cron "15 8 * * *" script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/camscanner/camscanner.js, tag=扫描全能王签到, img-url=https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/camscanner.png, enable=true
