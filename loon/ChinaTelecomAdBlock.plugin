#!name = 中国电信营业厅 · 全广告面净化
#!desc = 覆盖开屏、轮播、广告空间、信息流、本地、宽带、商城、消息营销、我的页、AI 营销、直播推广、积分广告与升级推广；默认保守，保留通信办理查询主链路。
#!openUrl = https://apps.apple.com/cn/app/id513836029
#!author = TomCatXue
#!homepage = https://github.com/TomCatXue/MyCookieCenter
#!icon = https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/icons/189.png
#!tag = 去广告, 中国电信, 净屏, Loon
#!system = iOS,iPadOS
#!loon_version = 3.5.2(1005)
#!version = 1.1.9
#!date = 2026-10-22 15:27

# 适用版本：CtClient 13.1.0 (CTPocket.app)
# 1. advertisingSpaceInfos / broadbandADSpaceInfo 是复用容器，可能承载话费、流量、积分、宽带入口；
#    脚本只删除带 isAd / adType / adInfo 等明确广告标记的项，不按字段名盲删。
# 2. 默认仅开启开屏、轮播、独立广告空间与浮层；其余频道开关默认关闭。
# 3. 混合接口异常、非 JSON、Protobuf 均原样透传；开屏 Protobuf 不在本插件内强改。

[Argument]
SplashClean = switch,true,tag=[开屏] 净化启动广告,desc=清理独立 JSON 开屏广告配置；Protobuf 开屏不会被脚本强改
CarouselClean = switch,true,tag=[轮播] 移除首页轮播,desc=清空首页与频道轮播/横幅数组，保留频道入口
AdSpaceClean = switch,true,tag=[广告位] 移除独立广告空间,desc=清理独立或明确标记的广告空间；复用容器中的业务入口保留
PopupClean = switch,true,tag=[浮层] 移除弹窗与挂件,desc=清理营销弹窗、悬浮窗、活动挂件与引导弹层
FeedNativeClean = switch,false,tag=[首页] 信息流原生广告,desc=仅过滤明确标记为广告的信息流卡片；默认关闭避免误删正文
LocalPromoClean = switch,false,tag=[本地] 优惠与推荐,desc=清理本地优惠、推荐和 O2O 广告，保留本地服务与营业厅
BroadbandPromoClean = switch,false,tag=[宽带] 推广楼层,desc=清理宽带广告位与推荐卡片，保留查询、续约、报装和故障服务
MallPromoClean = switch,false,tag=[商城] 推荐与活动广告,desc=清理商城广告区和套餐推广，保留商品、分类与下单链路
MessageMarketingClean = switch,false,tag=[消息] 营销消息,desc=仅过滤营销分类，保留系统通知、服务消息与订单通知
MinePromoClean = switch,false,tag=[我的] 钱包与推荐广告,desc=清理我的页固定/非固定广告和推荐卡片，保留账户、订单与设置
AiPromoClean = switch,false,tag=[AI] AI 营销服务,desc=仅清理 AI 营销服务与营销卡，保留 AI 创作、AI 服务楼层
LivePromoClean = switch,false,tag=[直播] 直播推广,desc=清理直播结束广告、直购引导和商品推广，保留直播功能本身
PointsPromoClean = switch,false,tag=[积分] 积分广告,desc=清理积分页广告字段，保留积分商品、账单与兑换链路
UpgradePromoClean = switch,false,tag=[升级] 5G 升级推广,desc=清理 5G 升级广告楼层，保留业务办理入口
TelemetryBlock = switch,true,tag=[性能] 阻断电信埋点,desc=预留开关；Loon Rule 不支持动态参数，本版埋点规则常驻有效

[Script]
# 广告接口统一响应净化：只处理 JSON，纯广告接口只清明确广告字段
response if ${url} ~= /^https?:\/\/[^/]+\/query\/(?:advertising\/(?:compositeAd|serviceChannelAd|mallPackageAd)|queryAdvertisingSpace|queryAdveSpac|queryMyChannelAdvSpace|queryAdRotation|queryCustomerAdvertising|queryTabCardAdList|queryIndexNearTabADSpa|qryNearConfigAdvertising|queryRollImage|getFeedList|getRecommendContentList|getRecommendFollowList|queryGuessYouLike|getPopupInfo|getPopUpWindows|accountInfoPopup|suspendWindow(?:ForQuery|ForWap|V2)?|suspend\/suspendWindow|loginSuspendWindow|getCareGuideDialog|xhPromote\/promotionalWindow|queryMessageList|getMessageCenterList|queryServiceMessage|queryMessageChannel|queryOneLevelMsg|queryTwoLevelMsg|queryThreeLevelMsg|indexMsgList|queryLocalTabAdSpace|queryLocalOAOSaleList|getLocalExclusive|qryBroadbandADSpace|queryBroadbandServiceFloor|getBroadbandSndScreenList|getSecondScreenList|yzfMallAdArea|yzfMallActivityArea|yzfMallTopArea|yzfMallJglArea|yzfMallRapidRecycleArea|qryHomeMall|queryRechargePageAD|queryRechargePageADSpace|queryRechargePageTabADSpace|queryRechargeMarketing|queryRechargePageV2|queryRechargePageFlow|queryRechargePageTab|queryRechargeSecuritySetting|rechargeCenterCommonADFloor|usageAnalysisCommonADFloor|querySettingPageAdList|queryBusHallAdvSpace|bottomTieADSpace|assistAdvSpace|qryTraAdvertisingSpace|queryAIMarketingService|queryAIServiceFloor|directSeedingAdGuide|recommendDirectSeedingList|queryLiveCard|myLiveCard|getLiveRoomGiftList|queryAnchorRankList|queryIntegralAd|queryUpgrade5GAd|queryMyChannelPageHead|qryMyChannelPageTail|myChannelFloor|queryMyChannelTop|queryMyChannelCoreData)(?:\?|$)/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/scripts/telecom/remove_ads.js?v=20261022-1527", {${SplashClean}, ${CarouselClean}, ${AdSpaceClean}, ${PopupClean}, ${FeedNativeClean}, ${LocalPromoClean}, ${BroadbandPromoClean}, ${MallPromoClean}, ${MessageMarketingClean}, ${MinePromoClean}, ${AiPromoClean}, ${LivePromoClean}, ${PointsPromoClean}, ${UpgradePromoClean}}) with tag="[中国电信]广告与推荐净化", timeout=10, requires_body=true

# 独立开屏 JSON 入口（get_splash_proto 为 Protobuf，不走此脚本）
response if ${url} ~= /^https?:\/\/[^/]+\/(?:getSplash|getSplashUrl|splash)(?:\?|$)/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/scripts/telecom/remove_ads.js?v=20261022-1527", {${SplashClean}, ${CarouselClean}, ${AdSpaceClean}, ${PopupClean}, ${FeedNativeClean}, ${LocalPromoClean}, ${BroadbandPromoClean}, ${MallPromoClean}, ${MessageMarketingClean}, ${MinePromoClean}, ${AiPromoClean}, ${LivePromoClean}, ${PointsPromoClean}, ${UpgradePromoClean}}) with tag="[中国电信]开屏净化", timeout=10, requires_body=true

[Rule]
# 电信官方行为数据 / 崩溃与 APM 上报：独立子域常驻阻断，不触碰业务网关
DOMAIN-SUFFIX,bigdata-behaviordata.189.cn,REJECT
DOMAIN-SUFFIX,res-behaviordata-app.189.cn,REJECT
DOMAIN-SUFFIX,reportappgo.189.cn,REJECT
DOMAIN-SUFFIX,errlog.umeng.com,REJECT
DOMAIN-SUFFIX,errlogos.umeng.com,REJECT
DOMAIN-SUFFIX,ulogs.umeng.com,REJECT
DOMAIN-SUFFIX,ulogs.umengcloud.com,REJECT

[MITM]
hostname = appgo.189.cn, appgoad.189.cn, appfuwu.189.cn, capp.189.cn, greycapp.189.cn
