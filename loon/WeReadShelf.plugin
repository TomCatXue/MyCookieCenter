#!name = 微信读书 · 优雅书架
#!desc = 专为微信读书设计：1.全自动嗅探订阅中的下架书籍；2.即时入架（/book/info 与 /shelf/sync），消除刷新延迟；3.解除 /book/chapterInfos 章节限制与价格为0，消除全免费却需选章节购买的冲突；4.拦截 /pay/buyChapters 伪装购买成功，杜绝402报错。
#!author = TomCatXue
#!homepage = https://github.com/TomCatXue/MyCookieCenter
#!icon = https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/35/92/e6/3592e6f4-0b0b-f2e4-7968-7033b281e1f5/AppIcon-0-1x_U007epad-0-11-0-85-220-0.png/512x512bb.jpg
#!tag = 微信读书,下架书,优雅书架,书架注入
#!version = 1.0.4
#!date = 2026-09-28 03:55

[Argument]
weread_shelf = switch,true,tag=微信读书·优雅书架,desc=总开关：开启后自动从订阅捕获下架书籍并动态注入书架与阅读器
weread_inject_books = input,"",tag=下架书籍ID列表(选填),desc=手动指定需要注入书架并解除阅读限制的下架书籍ID (多个用逗号分隔，留空则自动从订阅抓取)

[MITM]
hostname = i.weread.qq.com, weread.qq.com

[Script]
# 拦截订阅抓取、书架同步注入、书籍详情与阅读鉴权伪装
response if ${url} ~= /^https?:\/\/(i\.)?weread\.qq\.com\/(shelf\/(sync|syncbook|add|opus)|subscription\/books|book\/(info|infos|readinfo|paytime|chapterInfos)|pay\/buyChapters)/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/tools/wxread_enhance/wxread_shelf.js?v=20260928-0355", {${weread_inject_books}}) with enable=${weread_shelf}, tag="微信读书·优雅书架", requires_body=true
