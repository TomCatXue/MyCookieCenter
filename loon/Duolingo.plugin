[Script]
response if ${url} ~= /^https?:\/\/(?:ios-api-[a-z0-9-]+|api\d+)\.duolingo\.(?:com|cn)\/(?:\d{4}-\d{1,2}-\d{1,2}\/batch|.*\/users\/[^/?#]+(?:[?#]|$))/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/scripts/tools/duolingo/duolingo.batch.js?v=6a4385a3") with tag="订阅解锁", timeout=60, requires_body=true
response if ${url} ~= /^https?:\/\/(?:ios-api-[a-z0-9-]+|api\d+)\.duolingo\.(?:com|cn)\/.*\/(?:available-features|advertisable-features)/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/scripts/tools/duolingo/duolingo.features.js?v=59781f39") with tag="功能清单", timeout=60, requires_body=true

[MitM]
hostname = ios-api-*.duolingo.com, ios-api-*.duolingo.cn, api*.duolingo.com, api*.duolingo.cn
