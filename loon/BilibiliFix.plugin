#!name = 哔哩哔哩增强版 𝕏
#!desc = B站增强：空降助手、SponsorBlock、分区修复、消息推送修复、播放优化、VIP状态修复
#!author = TomCatXue
#!homepage = https://github.com/TomCatXue/MyCookieCenter
#!tag = Bilibili,SponsorBlock,修复增强


# ===========================================================
# 用户配置
# ===========================================================

[Argument]

sponsorBlock = switch,true,tag=空降助手

VIP = switch,true,tag=VIP接口增强

Authorization = input,"",tag=Authorization

UserAgent = input,"",tag=UserAgent



# ===========================================================
# 规则
# ===========================================================

[Rule]


# SponsorBlock服务器
DOMAIN,bsbsb.top,PROXY


# B站CDN直连

DOMAIN-SUFFIX,bilivideo.com,DIRECT

DOMAIN-SUFFIX,bilivideo.cn,DIRECT


# B站接口

DOMAIN-SUFFIX,bilibili.com,DIRECT

DOMAIN-SUFFIX,biliapi.net,DIRECT



# 清理P2P/STUN

AND,((DOMAIN-SUFFIX,chat.bilibili.com),(OR,((DOMAIN-KEYWORD,stun),(DOMAIN-KEYWORD,tracker),(DOMAIN-KEYWORD,p2p)))),REJECT



# ===========================================================
# URL Rewrite
# ===========================================================

[URL Rewrite]



# ---------------------------
# 分区修复
# ---------------------------


^https:\/\/app\.bilibili\.com\/x\/v2\/channel\/region\/list\?
mock-response-body data-type=text status-code=200 data='{"code":0,"message":"0","ttl":1,"data":[{"tid":1,"name":"动画"},{"tid":13,"name":"番剧"},{"tid":167,"name":"国创"},{"tid":3,"name":"音乐"},{"tid":129,"name":"舞蹈"},{"tid":4,"name":"游戏"},{"tid":36,"name":"知识"},{"tid":188,"name":"科技"},{"tid":234,"name":"运动"},{"tid":223,"name":"汽车"},{"tid":160,"name":"生活"},{"tid":211,"name":"美食"},{"tid":217,"name":"动物圈"},{"tid":119,"name":"鬼畜"},{"tid":155,"name":"时尚"},{"tid":5,"name":"娱乐"},{"tid":181,"name":"影视"}]}'



# grpc分区状态修复

^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.show\.v1\.(Mixture\/(RegionIndex|RegionList)|Rank\/RankRegionList)$

response-header-add grpc-status 0





# ---------------------------
# 消息推送修复
# ---------------------------


^https:\/\/api\.bilibili\.com\/x\/pd-proxy\/tracker\?

response-body-json-jq '.data[][]?="wss://tracker.chat.bilibili.com"'



^https:\/\/api\.live\.bilibili\.com\/xlive\/open-interface\/v2\/tracker\/conf\?

response-body-json-jq '.data.domains=["wss://tracker.chat.bilibili.com"]'




# ---------------------------
# VIP状态
# ---------------------------


^https:\/\/app\.bilibili\.com\/x\/v2\/account\/myinfo\?

response-body-json-jq '.data.vip |= if . != null then . + {"status":1,"type":2} else . end'





# ---------------------------
# 番剧支付字段
# ---------------------------


^https:\/\/api\.bilibili\.com\/pgc\/view\/v2\/app\/season\?

response-body-json-jq 'del(.data.payment)'





# ===========================================================
# Script
# ===========================================================


[Script]



# ===========================
# SponsorBlock
# ===========================


http-request ^https:\/\/grpc\.biliapi\.net\/bilibili\.community\.service\.dm\.v1\.DM\/DmView$

script-path=https://raw.githubusercontent.com/kokoryh/Sparkle/master/dist/bilibili.protobuf.request.js

argument=[{sponsorBlock}]

requires-body=true

binary-body-mode=true

timeout=10

enable={sponsorBlock}

tag=空降助手-DmView





http-request ^https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com|app\.biliapi\.net)\/bilibili\.community\.service\.dm\.v1\.DM\/DmSegMobile$

script-path=https://raw.githubusercontent.com/kokoryh/Sparkle/master/dist/bilibili.protobuf.request.js

argument=[{sponsorBlock}]

requires-body=true

binary-body-mode=true

timeout=10

enable={sponsorBlock}

tag=空降助手-DmSegMobile





http-response ^https:\/\/grpc\.biliapi\.net\/bilibili\.(view(unite)?\.v1\.View|app\.view\.v1\.View)\/ViewProgress$

script-path=https://raw.githubusercontent.com/kokoryh/Sparkle/master/dist/bilibili.protobuf.response.js

argument=[{sponsorBlock}]

requires-body=true

binary-body-mode=true

timeout=10

enable={sponsorBlock}

tag=空降助手-Progress





# ===========================
# 播放增强
# ===========================


http-request ^https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com|app\.biliapi\.net)\/.*Play(View|URL).*$

script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/plugins/bilibili/bilibili_vip.js

argument=[{Authorization},{UserAgent}]

binary-body-mode=true

requires-body=true

timeout=60

enable={VIP}

tag=播放增强





http-response ^https:\/\/app\.bilibili\.com\/x\/v\d\/(account\/(myinfo|mine)|feed\/index)\?

script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/plugins/bilibili/bilibili_vip.js

argument=[{Authorization},{UserAgent}]

requires-body=true

timeout=60

enable={VIP}

tag=画质增强




# ===========================================================
# MITM
# ===========================================================


[MITM]

hostname = grpc.biliapi.net,*.bilibili.com,*.biliapi.net