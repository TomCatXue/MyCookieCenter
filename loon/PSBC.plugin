#!name = 邮储银行去广告
#!desc = 屏蔽中国邮政储蓄银行手机银行开屏广告、摇一摇及静态广告资源。
#!openUrl = https://apps.apple.com/app/id493489515
#!author = chaoscard (原作) / TomCatXue
#!homepage = https://github.com/TomCatXue/MyCookieCenter
#!icon = https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/icons/psbc.png
#!tag = 邮储银行,去广告,开屏广告
#!source = 8c6a86c523c5bf25f9dd3fbdf0b49cb7007e2535ac5392ae6fb91442953ab875
#!type = normal
#!version = 1.0.0
#!date = 2026-11-21 14:40

[Rewrite]
# 1.拦截获取静态广告图片的接口
response if ${url} ~= /^https?:\/\/login-service\.mobile-bank\.psbc\.com\/.*\/getStartUpAdvPicture/ then reject(200)
# 2.拦截摇一摇开屏广告配置
response if ${url} ~= /^https?:\/\/login-service\.mobile-bank\.psbc\.com\/.*\/qryShakeInfo/ then reject(200)
# 3.拦截广告图片静态资源域名
request if ${url} ~= /^https?:\/\/static\.mobile-bank\.psbc\.com\/static\/index\/advertise\// then reject(200)

[MitM]
hostname = login-service.mobile-bank.psbc.com, static.mobile-bank.psbc.com
