#!name = Pixiv 小说翻译
#!desc = 在 Pixiv 小说阅读页注入翻译按钮，支持 Google 免费 / 微软翻译 / 百度翻译 / DeepSeek AI 翻译
#!author = TomCatXue
#!homepage = https://github.com/TomCatXue/MyCookieCenter
#!icon = https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/icons/pixiv.png
#!tag = Pixiv,小说,翻译,Google,微软,百度,DeepSeek,AI

[Argument]
# 总开关：默认关闭，按需开启
pixiv_novel_translate = switch,false,tag=小说翻译,desc=在 Pixiv 小说阅读页注入翻译按钮
# 默认翻译源: google / microsoft / baidu / deepseek
translator = input,google,tag=默认翻译源,desc=google=Google免费 microsoft=微软翻译 baidu=百度翻译 deepseek=DeepSeek AI
# 目标语言: zh-CN / zh-TW / en / ja / ko
target = input,zh-CN,tag=目标语言,desc=zh-CN简体 zh-TW繁体 en英文 ja日文 ko韩文
# 选择 microsoft 时填写
ms_key = input,,tag=微软翻译Key,desc=Ocp-Apim-Subscription-Key
# 选择 baidu 时填写
baidu_appid = input,,tag=百度AppID,desc=百度开放平台应用 ID
baidu_secret = input,,tag=百度密钥,desc=百度开放平台密钥
# 选择 deepseek 时填写
deepseek_api_url = input,https://api.deepseek.com/v1/chat/completions,tag=DeepSeek接口地址,desc=兼容 OpenAI 格式即可
deepseek_api_key = input,,tag=DeepSeek API Key,desc=DeepSeek 开放平台 API Key
deepseek_model = input,deepseek-v4-flash,tag=DeepSeek模型,desc=deepseek-v4-flash 快速便宜 deepseek-v4-pro 更强更贵
# 分块大小(字数): 100~3000，不填则按翻译源默认(google 400 / 微软 4500 / 百度 580 / deepseek 3000)
chunk = input,,tag=分块大小,desc=越小翻译越细、边翻边显示越顺滑，请求次数相应增多

[MITM]
hostname = app-api.pixiv.net

[Script]
# 页面注入：往小说阅读页插入“译”按钮
http-response ^https://app-api\.pixiv\.net/webview/v2/novel script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/plugins/pixiv_novel_translate/pixiv_novel_translate.js?v=20260828-r6, requires-body=true, timeout=30, tag=Pixiv 小说翻译-页面注入, enable={pixiv_novel_translate}

# 翻译中转：拦截 pxtrans 请求，由脚本直接返回 JSON 响应（不经过 Pixiv 上游）。
# 注意：Loon 的 http-request 中 $done({status,headers,body}) 会被当作“修改请求”发往上游，
# 导致上游返回 404、页面显示 [object Object]；必须用 $done({response:{...}}) 直接返回。
http-request ^https://app-api\.pixiv\.net/pxtrans script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/plugins/pixiv_novel_translate/pixiv_novel_translate.js?v=20260828-r6, requires-body=true, timeout=120, tag=Pixiv 小说翻译-翻译中转, enable={pixiv_novel_translate}