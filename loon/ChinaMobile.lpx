#!name = 中国移动 · 广告净化增强
#!desc = 在原版启动页、首屏与「我的」弹窗净化基础上，精确阻断「办宽带 / 移动智盒 / 带屏摄像头 / 爱家融合套餐」四个轮播落地页；按业务独立开关，避免误伤主动办理入口。
#!openUrl = https://apps.apple.com/app/id583700738
#!author = Yuheng0101, anker1209, ccyykk666, sooyaaabo; 轮播补丁 TomCatXue
#!tag = 去广告, 中国移动, 轮播净化
#!system = iOS,iPadOS
#!loon_version = 3.5.2(1005)
#!homepage = https://github.com/TomCatXue/MyCookieCenter
#!icon = https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/ChinaMobile.png
#!version = 3.2.0
#!date = 2026-10-22 11:31

# 基线来源（2026-10-22 拉取核对）：
# https://raw.githubusercontent.com/luoxmc/loon/main/Plugins/ChinaMobile.lpx
# https://raw.githubusercontent.com/ccyykk666/Loon-Plugin/main/plugins/china-mobile/china_mobile_ad.plugin
# 原插件地址已 302 到 Telegram，无法作为可复现来源；本文件以 luoxmc/loon 的版本为基线补齐现有开源净化项。
# 轮播页面证据：177_1792637907933.har（SHA-256 A1CE7DCDD1BB782D03BB051640E1FC7109F340064466BE635C3680786BF92FFA）。

[Argument]
HomeBasicClean = switch, true, tag = [首页] 基础净化, desc = 清理首页瀑布流、推荐位与活动广告
HideTopFamily = switch, false, tag = [首页] 隐藏-爱家, desc = 隐藏首页顶部 Tab「爱家」
HideTopAge = switch, false, tag = [首页] 隐藏-网龄, desc = 隐藏首页顶部 Tab「网龄」
HideTopPhone = switch, false, tag = [首页] 隐藏-手机, desc = 隐藏首页顶部 Tab「手机」
HideTopNearby = switch, false, tag = [首页] 隐藏-附近厅, desc = 隐藏首页顶部 Tab「附近厅」
HideTopAI = switch, false, tag = [首页] 隐藏-AI尝鲜, desc = 隐藏首页顶部 Tab「AI 尝鲜」
HideTopEnterprise = switch, false, tag = [首页] 隐藏-政企, desc = 隐藏首页顶部 Tab「政企」
MineClean = switch, true, tag = [我的] 基础净化, desc = 清理「我的」页面营销区域、签到浮窗与推荐卡片
ServicePageClean = switch, true, tag = [我的] 我的服务-广告净化, desc = 清理「我的服务」子模块广告
HideMyCheckIn = switch, false, tag = [我的] 隐藏-签到浮窗, desc = 隐藏「我的」签到浮窗（areaId 20230721008）
HideMyMarketing = switch, false, tag = [我的] 隐藏-营销区域, desc = 隐藏「我的」营销区域（areaId 20230721012）
HideMyServices = switch, false, tag = [我的] 隐藏-我的服务, desc = 隐藏「我的」我的服务（areaId 20230721018）
HideMyFamilyCube = switch, false, tag = [我的] 隐藏-我的家庭, desc = 隐藏「我的」我的家庭（areaId 20240708002）
HideMyDevicesCube = switch, false, tag = [我的] 隐藏-我的设备, desc = 隐藏「我的」我的设备（areaId 20251024002）
HideMyMiniProgram = switch, false, tag = [我的] 隐藏-我的账户, desc = 隐藏「我的」我的账户（areaId 20231017002）
HideMyDigitalHuman = switch, false, tag = [我的] 隐藏-AI智能助理, desc = 隐藏「我的」AI 智能助理（areaId 20230721020）
HideMySelections = switch, false, tag = [我的] 隐藏-我的优选, desc = 隐藏「我的」我的优选（areaId 20230721030）
HideMyGroup = switch, false, tag = [我的] 隐藏-我的集团, desc = 隐藏「我的」我的集团（areaId 20230721036）
HideMyRingtone = switch, false, tag = [我的] 隐藏-我的彩铃, desc = 隐藏「我的」我的彩铃（areaId 20251230002）
HideMyCloudDrive = switch, false, tag = [我的] 隐藏-我的云盘, desc = 隐藏「我的」我的云盘（areaId 20240624002）
HideMyToolbox = switch, false, tag = [我的] 隐藏-百宝箱, desc = 隐藏「我的」百宝箱（areaId 20230721044）
HideMyLifeServices = switch, false, tag = [我的] 隐藏-生活服务, desc = 隐藏「我的」生活服务（areaId 20230928004）
block_broadband = switch, true, tag = [轮播] 办宽带, desc = 阻断广告卡片进入「中国移动商城 · 宽带预约」，不影响主动按其他套餐办理
block_smartbox = switch, true, tag = [轮播] 移动智盒, desc = 阻断广告卡片进入「移动智盒」活动落地页
block_camera = switch, true, tag = [轮播] 带屏摄像头, desc = 阻断广告卡片进入「带屏摄像头」活动落地页
block_fusion = switch, true, tag = [轮播] 爱家融合套餐, desc = 阻断广告卡片进入「爱家融合套餐」活动落地页

[Rewrite]
# 原有开屏与基础广告规则
request if ${url} ~= /^https?:\/\/(?:client\.app\.coc|app)\.10086\.cn\/biz-orange\/DN\/(?:explorePage\/getAdverList|init\/startInit|emotionMarket)(?:\?.*)?$/i then reject(200)
request if ${url} ~= /^https?:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/(?:DN\/(?:dropsAdverService\/getDropsAdverNew|homepagePopup\/getSortInfo|toast\/getToastRule)|DH\/toast\/august\/getToast|DA\/liveSuspension\/getPageCode)(?:\?.*)?$/i then reject_dict(200)
response if ${url} ~= /^https:\/\/touch\.10086\.cn\/i\/v1\/pay\/popWindowQry\/[^?]+(?:\?.*)?$/i && ${response.status} == 200 then response.json.replace("data", null)
response if ${url} ~= /^https:\/\/ad\.mcloud\.139\.com\/advertapi\/adv-filter\/adv-filter\/AdInfoFilter\/getAdInfos(?:\?.*)?$/i && ${response.status} == 200 then response.json.jq(".body=[]")

# 2026-10-22 轮播广告：只拦精确落地 URL，不拦 /h5/server/empty/*、uniauth/initPage、nrapigate/* 等公用接口。
request if ${block_broadband} == true && ${url} ~= /^https:\/\/wx\.10086\.cn\/website\/businessPlatform\/home\/broadband\/broadbandBooking\?/i && ${url} ~= /[?&]productPackageId=2026061117294960202003480(?:&|$)/i && ${url} ~= /[?&]channelId=P00000042131(?:&|$)/i then reject(404)
request if ${block_smartbox} == true && ${url} ~= /^https:\/\/wap\.sn\.10086\.cn\/h5\/MobileSmartBox\/html\/index\.html\?/i && ${url} ~= /[?&]channelId=P00000042132(?:&|$)/i && ${url} ~= /[?&]yx=1501352005(?:&|$)/i then reject(404)
request if ${block_camera} == true && ${url} ~= /^https:\/\/wap\.sn\.10086\.cn\/h5\/CameraWithScreen\/html\/index\.html\?/i && ${url} ~= /[?&]channelId=P00000042133(?:&|$)/i && ${url} ~= /[?&]yx=1423518010(?:&|$)/i then reject(404)
request if ${block_fusion} == true && ${url} ~= /^https:\/\/wap\.sn\.10086\.cn\/h5\/HallFamilyFusionVerMediumhigh\/html\/index\.html\?/i && ${url} ~= /[?&]channelId=P00000042134(?:&|$)/i && ${url} ~= /[?&]yx=1501352006(?:&|$)/i then reject(404)

[Script]
# 基线页面净化脚本：与上游开源实现保持一致，继续复用现有远程脚本。
response if ${url} ~= /^https:\/\/(?:client\.app\.coc\.10086\.cn\/biz-orange\/(?:DN\/(?:homePage\/getTopAreaList|myPageNew\/getMyPageNew|multipleInterfaces\/aggregationData|init\/getNavigation|searchWord\/getSearchWordInfo)|DA\/baseServiceFunction\/getAdverList)|h\.app\.coc\.10086\.cn\/biz-orange\/DA\/baseServiceFunction\/getAdverList)(?:\?.*)?$/i then script("https://raw.githubusercontent.com/ccyykk666/Loon-Plugin/main/plugins/china-mobile/remove_ads.js?v=20261022", {${HomeBasicClean}, ${HideTopFamily}, ${HideTopAge}, ${HideTopPhone}, ${HideTopNearby}, ${HideTopAI}, ${HideTopEnterprise}, ${MineClean}, ${ServicePageClean}, ${HideMyCheckIn}, ${HideMyMarketing}, ${HideMyServices}, ${HideMyFamilyCube}, ${HideMyDevicesCube}, ${HideMyMiniProgram}, ${HideMyDigitalHuman}, ${HideMySelections}, ${HideMyGroup}, ${HideMyRingtone}, ${HideMyCloudDrive}, ${HideMyToolbox}, ${HideMyLifeServices}}) with tag="[中国移动]页面净化", timeout=10, requires_body=true
response if ${url} ~= /^https:\/\/h\.app\.coc\.10086\.cn\/biz-orange\/DH\/(?:message_query\/message\/query\/list|myCardVoucher\/getBannerList)(?:\?.*)?$/i then script("https://raw.githubusercontent.com/ccyykk666/Loon-Plugin/main/plugins/china-mobile/remove_ads.js?v=20261022") with tag="[中国移动]消息与卡券净化", timeout=10, requires_body=true
response if ${url} ~= /^https:\/\/app\.10086\.cn\/biz-orange\/DA\/commonBoard\/getCommonBoard(?:\?.*)?$/i then script("https://raw.githubusercontent.com/ccyykk666/Loon-Plugin/main/plugins/china-mobile/remove_ads.js?v=20261022") with tag="[中国移动]充值横幅净化", timeout=10, requires_body=true
response if ${url} ~= /^https:\/\/touch\.10086\.cn\/i\/v1\/cust\/(?:aiMainQry|iopBatchQry)\/[^?]+(?:\?.*)?$/i then script("https://raw.githubusercontent.com/ccyykk666/Loon-Plugin/main/plugins/china-mobile/remove_ads.js?v=20261022") with tag="[中国移动]充值内容净化", timeout=10, requires_body=true

[MITM]
hostname = client.app.coc.10086.cn, h.app.coc.10086.cn, app.10086.cn, touch.10086.cn, ad.mcloud.139.com, wx.10086.cn, wap.sn.10086.cn
