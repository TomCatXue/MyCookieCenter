#!name = 山西电信·体验AI领福利
#!desc = 探针监控版：仅解密活动H5域名，零证书报错；每月1-8号后台自动探针监控放水并单次提醒，当月已参与自动休眠。
#!author = Codex
#!homepage = https://github.com/TomCatXue/MyCookieCenter
#!icon = https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/icons/189.png
#!tag = 山西电信,福利抢兑,探针监控
#!version = 1.2.0
#!date = 2026-09-03

[MITM]
# 仅解密活动专用H5域名（不包含任何客户端原生域名，彻底根除证书报错）
hostname = wx.sx.189.cn

[Script]
# 1. 凭证自动捕获：在电信APP进入活动页面时自动记录最新 Cookie 与活动参数（新批次单次提醒）
http-request ^https:\/\/wx\.sx\.189\.cn\/sx_ai_benefit\/h5\/HD script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/plugins/sx_ai_benefit/sx_ai_benefit.js?v=20260903-v1.2.0, requires-body=false, tag=山西电信·捕获活动凭据, enable=true

# 2. 活动服务端探针：每月 1 号至 8 号，每天 08:00 至 20:00 随机唤醒探测（发现放水单次提醒，已参与深度休眠）
cron "*/20 8-19 1-8 * *" script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/plugins/sx_ai_benefit/sx_ai_benefit.js?v=20260903-v1.2.0, tag=山西电信·活动探针监控, enable=true
