#!name = 腾讯视频 · 全量净化
#!desc = 全量移除开屏、前贴/中插、暂停、后贴、锚点、详情页、信息流、搜索、下载页、个人中心、激励、会员推广与播放页 SVIP 推广；融合简洁模式、底栏独立开关与 QUIC 防穿透。
#!author = TomCatXue
#!homepage = https://github.com/TomCatXue/MyCookieCenter
#!icon = https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/icons/tencent_video.png
#!system = iOS,iPadOS
#!version = 1.0.10
#!date = 2026-11-08 10:35
#!loon_version = 3.5.1(983)
#!tag = 腾讯视频

[Argument]
HideShortDrama = switch,true,tag=[底栏] 隐藏短剧,desc=关闭后显示「短剧」tab
HideVipTab = switch,true,tag=[底栏] 隐藏 VIP 会员,desc=关闭后显示「VIP会员」tab
HideGoods = switch,true,tag=[底栏] 隐藏好物,desc=关闭后显示「好物」tab

[Rule]
# 开屏 QUIC 预加载/跟踪主机直接拒绝
DOMAIN,iacc.stgw.qq.com,REJECT
DOMAIN,tacc.video.qq.com,REJECT
# GDT 广告联盟与广告追踪/遥测
DOMAIN-SUFFIX,gdt.qq.com,REJECT
DOMAIN,p.l.qq.com,REJECT
DOMAIN,dp3.qq.com,REJECT
DOMAIN,otheve.beacon.qq.com,REJECT
# IPA 中标记为 prerollAdDomain / adServerDomain 的主机
DOMAIN,lives.l.qq.com,REJECT
DOMAIN,news.l.qq.com,REJECT
# 强制 tRPC/JCE 走 TCP，确保 MITM 能捕获二进制帧
AND,((DOMAIN,i.video.qq.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN,i.video.qq.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT
AND,((DOMAIN,pre.video.qq.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN,pre.video.qq.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT
AND,((DOMAIN,iacc.qq.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN,iacc.qq.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT

[Rewrite]
# 清除 Alt-Svc，避免客户端继续协商 HTTP/3
^https?:\/\/(?:i|pre)\.video\.qq\.com\/ response-header-replace Alt-Svc clear
^https?:\/\/iacc\.qq\.com\/ response-header-replace Alt-Svc clear
# 播放页 SVIP 推广：返回空广告位（HAR 证据 vip.video.qq.com/rpc/trpc.vip_ad_promotion.accessor.Accessor/Access）
response if ${url} ~= /^https?:\/\/vip\.video\.qq\.com\/rpc\/trpc\.vip_ad_promotion\.accessor\.Accessor\/Access(?:\?|$)/ then response.body.mock("text", "{\"trace_id\":\"\",\"map_ads\":{},\"ext_info\":\"\"}", 200)
# 播放页特惠 VIP 价格：返回空价格表（HAR 证据 GetSvipPrices）
response if ${url} ~= /^https?:\/\/vip\.video\.qq\.com\/rpc\/trpc\.vip_price_group\.svip_price_logic\.SvipPriceLogic\/GetSvipPrices(?:\?|$)/ then response.body.mock("text", "{\"prices\":{}}", 200)
# 播放页升级 VIP 信息：返回空升级信息（HAR 证据 GetVipUpdateInfos）
response if ${url} ~= /^https?:\/\/vip\.video\.qq\.com\/rpc\/rpc\/trpc\.svip_proj\.trpc_vip_update\.GetVipUpdateInfos\/GetVipUpdateInfos(?:\?|$)/ then response.body.mock("text", "{\"update_infos\":{}}", 200)

[Script]
# tRPC：请求侧破坏广告函数名，响应侧清理 AdFeedInfo / GetTabListRsp / 个人中心广告
request if ${url} ~= /^https?:\/\/(?:i|pre)\.video\.qq\.com\/(?:\?.*)?$/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/158f54f/scripts/tools/txvideo/tencent_video_ad_clean.js?v=202611081035", {${HideShortDrama}, ${HideVipTab}, ${HideGoods}}) with tag="腾讯视频·请求拦截", requires_body=true, binary_body_mode=true
response if ${url} ~= /^https?:\/\/(?:i|pre)\.video\.qq\.com\/(?:\?.*)?$/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/158f54f/scripts/tools/txvideo/tencent_video_ad_clean.js?v=202611081035", {${HideShortDrama}, ${HideVipTab}, ${HideGoods}}) with tag="腾讯视频·tRPC净化", requires_body=true, binary_body_mode=true

# JCE：开屏/前贴/中插/暂停/播放提示/青少年弹窗
response if ${url} ~= /^https?:\/\/iacc\.qq\.com\/(?:\?.*)?$/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/158f54f/scripts/tools/txvideo/tencent_video_ad_clean.js?v=202611081035", {${HideShortDrama}, ${HideVipTab}, ${HideGoods}}) with tag="腾讯视频·JCE净化", requires_body=true, binary_body_mode=true

# AB 配置：简洁模式、底栏裁剪、VIP tab 关闭、QUIC/预解析关闭
response if ${url} ~= /^https?:\/\/(?:config|tconfig)\.ab\.qq\.com\/tab\/GetTab(?:RemoteConfig|Toggle)/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/158f54f/scripts/tools/txvideo/tencent_video_ad_clean.js?v=202611081035", {${HideShortDrama}, ${HideVipTab}, ${HideGoods}}) with tag="腾讯视频·简洁模式", requires_body=true, binary_body_mode=true
response if ${url} ~= /^https?:\/\/tab\.video\.qq\.com\/tab\/GetTabRemoteConfig/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/158f54f/scripts/tools/txvideo/tencent_video_ad_clean.js?v=202611081035", {${HideShortDrama}, ${HideVipTab}, ${HideGoods}}) with tag="腾讯视频·播放器配置", requires_body=true, binary_body_mode=true

# RDelivery 灰度：tab_gray 置 false
response if ${url} ~= /^https?:\/\/rdelivery\.qq\.com\/v1\/sdkconfig\/get/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/158f54f/scripts/tools/txvideo/tencent_video_ad_clean.js?v=202611081035", {${HideShortDrama}, ${HideVipTab}, ${HideGoods}}) with tag="腾讯视频·灰度开关", requires_body=true, binary_body_mode=true

[MITM]
hostname = i.video.qq.com, pre.video.qq.com, iacc.qq.com, config.ab.qq.com, tconfig.ab.qq.com, tab.video.qq.com, rdelivery.qq.com, vip.video.qq.com
