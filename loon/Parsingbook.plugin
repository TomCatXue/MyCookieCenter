#!name = 用心读书 · 体验优化与特权调试
#!desc = 适配用心读书 2.7.1 (v3) 与 2.6.3 (v2)：动态毫秒级计算时钟与 AES-128-CBC 封包，彻底消除“数据校验失败”，解锁全套会员特权。
#!homepage = https://github.com/TomCatXue/MyCookieCenter
#!icon = https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/icons/yxds.png
#!author = TomCatXue
#!system = iOS,iPadOS,macOS
#!system_version = 15.0
#!loon_version = 3.5.1(988)
#!tag = 用心读书,防强更,体验优化,工具
#!version = 3.0.0
#!date = 2026-09-27 17:35

[Rule]
# 拦截友盟统计与崩溃日志上报通道
DOMAIN, errnewlog.umeng.com, REJECT
DOMAIN, errnewlogos.umeng.com, REJECT
DOMAIN, ucc.umeng.com, REJECT
DOMAIN, aspect-upush.umeng.com, REJECT

[URL Rewrite]
# 过滤特权营销文案与非必要日志上传
^https:\/\/api\.07book\.com\/v[23]\/app\/get\.vip\.tips reject-dict
^https:\/\/api\.07book\.com\/v[23]\/upload\/input\/form reject-dict

[Script]
# 动态毫秒级 Mock：解决硬编码静态密文超出 300 秒导致“数据校验失败”问题
http-response ^https:\/\/api\.07book\.com\/v3\/(authority\/(checking|list|verify|devices|bindtomember)|member\/info|titles\/new|apple\/pay\/verify|app\/get\.version\.ios) script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/tools/parsingbook/parsingbook_mock.js, requires-body=true, tag=用心读书·动态Mock

[MITM]
hostname = api.07book.com
