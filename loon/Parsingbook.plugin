[Argument]
parsingbook_unlock = switch,true,tag=用心读书·会员解锁,desc=开启后自动重定向鉴权网关并激活终身会员与设备授权特权

[Rewrite]
# 重定向核心鉴权接口至 Cloudflare Worker 中继
^https:\/\/api\.07book\.com\/v2\/(member\/info|titles(?!\/)|authority\/(list|devices|verify|checking)) header https://mock.parsingbook.workers.dev/parsingbook/v2/$1

[MITM]
hostname = api.07book.com
