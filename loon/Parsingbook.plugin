#!name = 用心读书 · 体验优化与特权调试
#!desc = 适配用心读书 2.7.1 (v3) 与 2.6.3 (v2)：解密回放全套会员档案(member/info)、防强更与设备授权。
#!homepage = https://github.com/TomCatXue/MyCookieCenter
#!icon = https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/icons/yxds.png
#!author = TomCatXue
#!system = iOS,iPadOS,macOS
#!system_version = 15.0
#!loon_version = 3.5.1(988)
#!tag = 用心读书,防强更,体验优化,工具
#!version = 2.2.0
#!date = 2026-09-27 17:15

[Rule]
# 拦截友盟统计与崩溃日志上报通道
DOMAIN, errnewlog.umeng.com, REJECT
DOMAIN, errnewlogos.umeng.com, REJECT
DOMAIN, ucc.umeng.com, REJECT
DOMAIN, aspect-upush.umeng.com, REJECT

[URL Rewrite]
# 过滤特权营销文案与非必要日志上传
^https:\/\/api\.07book\.com\/v[23]\/app\/get\.vip\.tips reject-dict
^https:\/\/api\.07book\.com\/v[23]\/upload\/input\/form reject-dict

[Rewrite]
# 1. 屏蔽 iOS 强制更新弹窗 (v3 接口返回 forces=0, versionCode=7)
response if ${url} ~= /^https:\/\/api\.07book\.com\/v3\/app\/get\.version\.ios/i then response.body.mock("text", "S2L3pr50xgK0s9WBAAUUqwxRDo8JPlABUZiLf/9vFWmFz4A3nnLmUWc3xMwYAdWxGBtD74n8hv3nE8F5tIwrKDU8itYzK9Knd6DyX9JvnXBqTYZdhKc3gEdF8zOHmlHnbZcGDit404Nlpnis/RzObJ/fEd8yjZxMQtOwIR7MEcYJtIeFXmVSCAegJshzpeXQf6NQXzU2CjZ98QBc68xEZUMJ4AUgNc7LY552PXC4yLA=", 200)

# 2. 会员用户档案核心接口 (v3 member/info 返回 pass=true 及永久至尊会员头衔)
response if ${url} ~= /^https:\/\/api\.07book\.com\/v3\/member\/info/i then response.body.mock("text", "", 200)

# 3. 苹果 IAP 恢复购买校验 (v3 apple/pay/verify 返回已激活状态)
response if ${url} ~= /^https:\/\/api\.07book\.com\/v3\/apple\/pay\/verify/i then response.body.mock("text", "S2L3pr50xgK0s9WBAAUUq0mV1CzeD7HrDGFYjEtkn7/4XKS7HITrYrzxZzlDl8MVg7QcPBsvSCzeXjjXOk4GABkHUIqsgGCpUrEM/kuzZrq4fwKgn6OqIJoHYibjDv7+N8QU9MZNlixFHbpyZjmmHhBOredvSXNnxlnqaxnHWfKodPzE9vh+5jCP5jaJ6VQajP6ZoXSrJW4VwOBNJxpMvs+UMidS64PyAoGx78Ht1pQ=", 200)

# 4. 会员头衔同步 (v3 titles/new)
response if ${url} ~= /^https:\/\/api\.07book\.com\/v3\/titles\/new/i then response.body.mock("text", "", 200)

# 5. 周期性权限保活检测 (v3 authority/checking 返回 state=1)
response if ${url} ~= /^https:\/\/api\.07book\.com\/v3\/authority\/checking/i then response.body.mock("text", "S2L3pr50xgK0s9WBAAUUqwxRDo8JPlABUZiLf/9vFWkzvmwMYIJFDc/leGOhEKMY90eSX4HYhZ3Y2qwb9ZuvOPejJmK2aniuj6ta6Sx6n9dG9P3/dt3WfxavcB73wnb/9z6SbQVZpt+QqLWPNNrD+iECnvp3L0qm0YAF3iFB9IxexerwKELdl9f2T8ZTFXOqeTBnRUF13py51B3NOiLLCxVDCiXOT52NvP1/1NPiRRsuDCe5jh0IYhV/wQTllyvR", 200)

# 6. 授权许可证列表 (v3 authority/list 返回永久会员卡片)
response if ${url} ~= /^https:\/\/api\.07book\.com\/v3\/authority\/list/i then response.body.mock("text", "", 200)

# 7. 授权码激活核销接口 (v3 authority/verify 返回合法激活信息)
response if ${url} ~= /^https:\/\/api\.07book\.com\/v3\/authority\/verify/i then response.body.mock("text", "", 200)

# 8. 设备列表查询 (v3 authority/devices)
response if ${url} ~= /^https:\/\/api\.07book\.com\/v3\/authority\/devices/i then response.body.mock("text", "", 200)

# 9. 会员账号绑定 (v3 authority/bindtomember)
response if ${url} ~= /^https:\/\/api\.07book\.com\/v3\/authority\/bindtomember/i then response.body.mock("text", "S2L3pr50xgK0s9WBAAUUqwxRDo8JPlABUZiLf/9vFWkzvmwMYIJFDc/leGOhEKMYkkv6PF9IgavDT8L6fwQJ+dtLdOcSyhf0V5ZjkA4cg4P3FrD/FlM3z3KODpiPkXXlGviiVkPdkwBQrrjFJVSPUA==", 200)

# 10. 兼容 2.6.3 旧版 v2 接口
response if ${url} ~= /^https:\/\/api\.07book\.com\/v2\/authority\/checking/i then response.body.mock("text", "cxASdYoqg3ZsSzrtjmMFJZPnyQkxkzA+jAqAbI8Y1OHP90XvWKRhenGQZr/Nx9dEL4L0UDYsN8KZdsN5slY0v1ZwAkpCdhgCiUgJL7g9nc0=", 200)

[MITM]
hostname = api.07book.com
