#!name = 微信读书 · 优雅收录
#!desc = 轻触下架好书详情页或订阅人数，好书即刻自动入架。专为下架与待上架好书收录设计。
#!author = 水君 (原作) + TomCatXue (重构优化)
#!homepage = https://github.com/TomCatXue/MyCookieCenter
#!icon = https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/icons/weread.png
#!tag = 微信读书,好书收录,优雅工具

[MITM]
hostname = i.weread.qq.com

[Script]
# 轻触下架好书或订阅人数 → 自动收录入架
http-request ^https:\/\/i\.weread\.qq\.com\/(subscription\/users|book\/readingStat) script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/plugins/wxread/wxread.js, tag=微信读书·优雅收录, enable=true
