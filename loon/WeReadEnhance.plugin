#!name = 微信读书增强 · 全功能独立版
#!desc = 微信读书专属增强插件：每日阅读奖励、周二翻牌、每周限免好书入架与轻触入架。所有功能采用纯独立单体 JS 执行，彼此解耦互不影响。
#!author = TomCatXue
#!homepage = https://github.com/TomCatXue/MyCookieCenter
#!icon = https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/icons/weread.png
#!tag = 微信读书,自动签到,翻牌抽奖,好书入架,独立单体
#!version = 2.3.0
#!date = 2026-09-05

# =================== 功能开关 ===================

[Argument]
weread_capture = switch,true,tag=微信读书·凭据捕获,desc=打开微信读书App自动捕获vid/skey/Token
prefer_coin = select,"2","1",tag=微信读书·奖励偏好,desc=2:优先书币(推荐); 1:优先体验卡
weread_claim_cron = switch,true,tag=微信读书·每日阅读奖励,desc=每晚 23:00 自动检查并领取阅读时长与天数奖励
weread_flip_cron = switch,true,tag=微信读书·周二翻牌抽奖,desc=每周二 20:00 自动参与翻牌抽奖游戏并同步H5凭证
weread_free_cron = switch,true,tag=微信读书·每周限免入架,desc=每周五 10:00 自动将本周免费图书馆好书批量加入书架
weread_shelf_add = switch,true,tag=微信读书·好书即刻入架,desc=轻触在读人数或订阅人数自动将好书加入书架

# =================== MITM 解密域名 ===================

[MITM]
hostname = i.weread.qq.com, weread.qq.com

# =================== 规则配置 (各功能独立脚本) ===================

[Script]
# --- 1. 凭据捕获 (独立单体: weread_claim.js) ---
http-request ^https?://i\.weread\.qq\.com/(user/|feature|mobileSync|readdata/|pay/) script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/app/weread_claim/weread_claim.js, tag=微信读书·凭据捕获, requires-body=false, enable={weread_capture}
http-request POST ^https?://i\.weread\.qq\.com/login script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/app/weread_claim/weread_claim.js, tag=微信读书·登录捕获, requires-body=true, enable={weread_capture}
http-response POST ^https?://i\.weread\.qq\.com/login script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/app/weread_claim/weread_claim.js, tag=微信读书·Token捕获, requires-body=true, enable={weread_capture}
http-request ^https?://weread\.qq\.com/flip-card-game script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/app/weread_claim/weread_claim.js, tag=微信读书·翻牌Cookie, requires-body=false, enable={weread_capture}

# --- 2. 每日阅读奖励 (独立单体: weread_claim.js) ---
cron "0 23 * * *" script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/app/weread_claim/weread_claim.js, tag=微信读书·每日阅读奖励, enable={weread_claim_cron}

# --- 3. 周二翻牌抽奖 (独立单体: weread_flip.js) ---
cron "0 20 * * 2" script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/app/weread_claim/weread_flip.js, tag=微信读书·周二翻牌抽奖, enable={weread_flip_cron}

# --- 4. 每周限免入架 (独立单体: weread_free.js) ---
cron "0 10 * * 5" script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/app/weread_claim/weread_free.js, tag=微信读书·每周限免入架, enable={weread_free_cron}

# --- 5. 优雅收录入架 (独立单体: wxread.js) ---
http-request ^https:\/\/i\.weread\.qq\.com\/(subscription\/users|book\/readingStat) script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/plugins/wxread/wxread.js, tag=微信读书·好书收录, enable={weread_shelf_add}
