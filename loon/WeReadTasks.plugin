#!name = 微信读书活动任务
#!desc = 抓取完整票据后每日阅读奖励、翻牌抽奖、限免入架自动执行。
#!author = TomCatXue
#!homepage = https://github.com/TomCatXue/MyCookieCenter
#!icon = https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/icons/weread.png
#!tag = 微信读书,签到,自动化
#!source = 3468eae567f3021d456dfe6ebb6b5ff32b81bf702ed599b6ee551e46e615df8a, ac9bde2aaf7375f970b8c7fbb790e616e5d970a2b475095dad42834706afffb5
#!type = normal
#!version = 1.1.0
#!date = 2026-11-21 14:40

[Argument]
capture = switch,false,tag=票据捕获,desc=打开微信读书「我」和「翻牌/限免」页面补齐完整票据，抓完建议关闭
claim = switch,true,tag=每日阅读奖励,desc=每天23:05自动领取阅读时长与连续阅读奖励
flip = switch,true,tag=翻牌抽奖,desc=每周二20:05自动翻牌抽奖并更新Web票据
free = switch,true,tag=限免入架,desc=每周五10:05自动领取/助力限免好书入架

# --- 限免优选（方案B：预置偏好自动挑选）---
helper = input,"",tag=助力小号凭据,desc=格式 wr_vid#wr_skey#wr_rt，多个用 | 分隔（如 123#abc#def|456#ghi#jkl）。每个小号每周限助力1本，配2个可满2本
minCount = input,"500",tag=评价人数下限,desc=人数太少则评分无统计意义，低于此值不选。留空=500
maxCount = input,"0",tag=评价人数上限,desc=0=不限制；设15000可避开烂大街畅销书，专挑小众高分书
minRating = input,"850",tag=好评率下限,desc=百分制×10，850=85.0%。低于此值视为「很多人读过但评价一般」。留空=850
preferCats = input,"",tag=优先分类,desc=一级分类白名单，逗号分隔（历史,文学,精品小说）。留空=不限
excludeCats = input,"",tag=排除分类,desc=一级分类黑名单，逗号分隔。留空=不排除
excludeWords = input,"",tag=排除关键词,desc=书名包含即跳过，逗号或 | 分隔（如 套装,全译,实录,大典）
diversify = switch,true,tag=分类多样化,desc=第2本强制换一级分类，避免两本同类
fallbackLink = switch,true,tag=无小号时推链接,desc=未配置小号或助力额度用完时，推送微信一键直达领取链接

[Script]
request if ${url} ~= /^https?:\/\/(i\.)?weread\.qq\.com\/(flip-card-game|user\/|feature|free\/library|checkfreequalify|login)/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/weread/weread_cookie.js?v=7a55ec4b") with enable=${capture}, tag="微信读书·票据捕获", requires_body=true, img_url="https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/icons/weread.png"
response if ${url} ~= /^https?:\/\/i\.weread\.qq\.com\/login/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/weread/weread_cookie.js?v=7a55ec4b") with enable=${capture}, tag="微信读书·登录回填", requires_body=true, img_url="https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/icons/weread.png"
cron "5 23 * * *" then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/weread/weread_claim.js?v=a4dd2ca1") with enable=${claim}, timeout=180, tag="微信读书·阅读奖励", img_url="https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/icons/weread.png"
cron "5 20 * * 2" then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/weread/weread_flip.js?v=983807c6") with enable=${flip}, timeout=180, tag="微信读书·翻牌抽奖", img_url="https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/icons/weread.png"
cron "5 10 * * 5" then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/weread/weread_free.js?v=43a7eaf7", "helper=${helper}&minCount=${minCount}&maxCount=${maxCount}&minRating=${minRating}&preferCats=${preferCats}&excludeCats=${excludeCats}&excludeWords=${excludeWords}&diversify=${diversify}&fallbackLink=${fallbackLink}") with enable=${free}, timeout=300, tag="微信读书·限免入架", img_url="https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/icons/weread.png"

[MitM]
hostname = weread.qq.com, i.weread.qq.com
