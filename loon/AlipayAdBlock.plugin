#!name = 支付宝广告屏蔽
#!desc = 拦截支付宝内推广资源请求与广告创意图，净化运营配置
#!author = TomCatXue
#!homepage = https://github.com/TomCatXue/MyCookieCenter
#!icon = https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/icons/alipay.png
#!tag = 支付宝,广告屏蔽,净化

# 广告创意图 CDN — 直接 REJECT
[Rule]
DOMAIN-SUFFIX,ad_mgr,REJECT

# URL 重写 — 拦截推广资源请求与创意图（匹配 http/https）
[URL Rewrite]
^https?://gw\.alipayobjects\.com/os/imaspmng/ _ reject
^https?://mdn\.alipayobjects\.com/ad_mgr/ _ reject
^https?://mdn\.alipayobjects\.com/uri/img/gw\.alipayobjects\.com/zos/promocreative/ _ reject

# MITM 主机（必须安装并信任 Loon 的 CA 证书）
[MITM]
hostname = gw.alipayobjects.com, m5-zb.amap.com, acs.m.goofish.com, mobile.12306.cn

# 规则
[Script]
# 高德推广资源（气泡/弹窗）— 清空 data，返回空运营位
http-response ^https:\/\/m5-zb\.amap\.com\/ws\/promotion-web\/resource script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/plugins/alipay_ad/alipay_ad.js, tag=高德推广净化, enable=true

# 闲鱼支付宝营销券 — 清空 data，无券可弹
http-response ^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.alipay\.market\.voucher script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/plugins/alipay_ad/alipay_ad.js, tag=闲鱼营销券净化, enable=true

# 12306 支付宝小程序首页配置 — 清轮播广告/banner/导流位，保留核心功能
http-response ^https:\/\/mobile\.12306\.cn\/wxxcx\/alipay\/main\/conf script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/plugins/alipay_ad/alipay_ad.js, tag=12306广告净化, enable=true
