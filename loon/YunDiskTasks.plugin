#!name = 移动云盘活动任务
#!desc = 抓取 Authorization 后每日签到、云朵领取与商品抢兑自动执行；签到与抢兑均使用 Loon 原生脚本，无需青龙环境。
#!author = TomCatXue
#!homepage = https://github.com/TomCatXue/MyCookieCenter
#!icon = https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/icons/10086.png
#!tag = 中国移动,移动云盘,签到,自动化
#!version = 1.1.0
#!date = 2026-11-14 16:27

[Argument]
capture = switch,false,tag=Authorization捕获,desc=打开移动云盘App首页抓取Authorization，抓完建议关闭
sign = switch,true,tag=每日签到,desc=每天08:05自动签到并领取云朵
exchange = switch,true,tag=商品抢兑,desc=每天00:00/10:00/16:00补货后立即查询商品并按抢兑商品ID下单
auth = input,"",tag=手动凭据(可选),desc=未抓取到ydyp_data时填写，格式：手机号@Authorization（单账号）
prizes = input,"",tag=抢兑商品ID(可选),desc=英文逗号分隔的prizeId；留空仅查询商品与余量

[Script]
request if ${url} ~= /^https?:\/\/user-njs\.yun\.139\.com\/user\//i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/tools/yundisk/yundisk.cookie.js?v=944eb970") with enable=${capture}, tag="移动云盘·凭据捕获", img_url="https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/icons/10086.png"
cron "5 8 * * *" script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/tools/yundisk/ydyp.loon.js?v=f0476a13, argument="mode=sign&auth=${auth}", enable=${sign}, timeout=180, tag="移动云盘·每日签到", img-url="https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/icons/10086.png"
cron "59 9,15,23 * * *" script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/tools/yundisk/ydyp.loon.js?v=f0476a13, argument="mode=exchange&auth=${auth}&prizes=${prizes}", enable=${exchange}, timeout=300, tag="移动云盘·商品抢兑", img-url="https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/icons/10086.png"

[MITM]
hostname = user-njs.yun.139.com
