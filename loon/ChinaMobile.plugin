#!name = 中国移动 · 净屏与功能增强
#!desc = 彻底净化启动页、首页轮播、各专区横幅推广与「我的」弹窗，底层物理级彻底移除轮播图组件；标准插件格式。
#!openUrl = https://apps.apple.com/app/id583700738
#!author = Yuheng0101, anker1209, ccyykk666, sooyaaabo; 轮播净化 TomCatXue
#!tag = 去广告, 中国移动, 轮播净化
#!system = iOS,iPadOS
#!loon_version = 3.5.2(1005)
#!homepage = https://github.com/TomCatXue/MyCookieCenter
#!icon = https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/ChinaMobile.png
#!version = 1.0.4
#!date = 2026-10-23 18:20

# 核心升级说明（2026-10-22 v1.0.3）：
# 1. 纯粹净屏与轮播消除：移除一切针对跳过支付 VPN 的多余网络规则，支付时请直接关闭 VPN 完成付款（iOS 端和包支付 SDK 在 Native 层扫描网络接口，开启代理时任何伪装规则均无效，关闭代理为唯一确定路径）。
# 2. 开关参数格式严谨化：严格遵循 Loon 标准 key = type,default,tag=...,desc=... 格式，剔除多余空格，彻底解决 Loon UI 切换开关时只能关闭不能打开的异常。
# 3. 轮播图物理级消除：在底层 AES 解密接口 (getAdverList / getTopAreaList) 中直接剔除「横幅轮播区」与四大目标推广，使前端轮播组件彻底消失而非仅阻断点击。
# 4. 开关业务代码双向联动：全量打通 23 个开关在核心脚本中的双向联动逻辑，确保每一个开关开启/关闭均精准生效。

[Argument]
HideCarousel = switch,true,tag=[轮播] 彻底移除轮播图,desc=移除首页与各专区横幅轮播图组件及四大落地推广（办宽带/智盒/摄像头/融合套餐），使其彻底消失而非仅阻断跳转
HomeBasicClean = switch,true,tag=[首页] 基础净化,desc=清理首页瀑布流、推荐位与活动广告
ServicePageClean = switch,true,tag=[专区] 专区横幅净化,desc=清理话费/余量等业务专区横幅推广
MineClean = switch,true,tag=[我的] 基础净化,desc=清理「我的」页面营销区域、签到浮窗与推荐卡片
HideTopFamily = switch,false,tag=[首页] 隐藏-爱家,desc=隐藏首页顶部 Tab「爱家」
HideTopAge = switch,false,tag=[首页] 隐藏-网龄,desc=隐藏首页顶部 Tab「网龄」
HideTopPhone = switch,false,tag=[首页] 隐藏-手机,desc=隐藏首页顶部 Tab「手机」
HideTopNearby = switch,false,tag=[首页] 隐藏-附近厅,desc=隐藏首页顶部 Tab「附近厅」
HideTopAI = switch,false,tag=[首页] 隐藏-AI尝鲜,desc=隐藏首页顶部 Tab「AI 尝鲜」
HideTopEnterprise = switch,false,tag=[首页] 隐藏-政企,desc=隐藏首页顶部 Tab「政企」
HideMyCheckIn = switch,false,tag=[我的] 隐藏-签到浮窗,desc=隐藏「我的」签到浮窗（areaId 20230721008）
HideMyMarketing = switch,false,tag=[我的] 隐藏-营销区域,desc=隐藏「我的」营销区域（areaId 20230721012）
HideMyServices = switch,false,tag=[我的] 隐藏-我的服务,desc=隐藏「我的」我的服务（areaId 20230721018）
HideMyFamilyCube = switch,false,tag=[我的] 隐藏-我的家庭,desc=隐藏「我的」我的家庭（areaId 20240708002）
HideMyDevicesCube = switch,false,tag=[我的] 隐藏-我的设备,desc=隐藏「我的」我的设备（areaId 20251024002）
HideMyMiniProgram = switch,false,tag=[我的] 隐藏-我的账户,desc=隐藏「我的」我的账户（areaId 20231017002）
HideMyDigitalHuman = switch,false,tag=[我的] 隐藏-AI智能助理,desc=隐藏「我的」AI 智能助理（areaId 20230721020）
HideMySelections = switch,false,tag=[我的] 隐藏-我的优选,desc=隐藏「我的」我的优选（areaId 20230721030）
HideMyGroup = switch,false,tag=[我的] 隐藏-我的集团,desc=隐藏「我的」我的集团（areaId 20230721036）
HideMyRingtone = switch,false,tag=[我的] 隐藏-我的彩铃,desc=隐藏「我的」我的彩铃（areaId 20251230002）
HideMyCloudDrive = switch,false,tag=[我的] 隐藏-我的云盘,desc=隐藏「我的」我的云盘（areaId 20240624002）
HideMyToolbox = switch,false,tag=[我的] 隐藏-百宝箱,desc=隐藏「我的」百宝箱（areaId 20230721044）
HideMyLifeServices = switch,false,tag=[我的] 隐藏-生活服务,desc=隐藏「我的」生活服务（areaId 20230928004）

[Rule]
# APM 行为与埋点日志上报拦截（物理级阻断，省电防追踪）
DOMAIN-SUFFIX, cmicapm.com, REJECT
DOMAIN-SUFFIX, dc.cmicapm.com, REJECT
DOMAIN-SUFFIX, jiguang.coc.10086.cn, REJECT

[Rewrite]
# 开屏与基础广告规则
request if ${url} ~= /^https?:\/\/(?:client\.app\.coc|app)\.10086\.cn\/biz-orange\/DN\/(?:explorePage\/getAdverList|init\/startInit|emotionMarket)(?:\?.*)?$/i then reject(200)
request if ${url} ~= /^https?:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/(?:DN\/(?:dropsAdverService\/getDropsAdverNew|homepagePopup\/getSortInfo|toast\/getToastRule)|DH\/toast\/august\/getToast|DA\/liveSuspension\/getPageCode)(?:\?.*)?$/i then reject_dict(200)
response if ${url} ~= /^https:\/\/ad\.mcloud\.139\.com\/advertapi\/adv-filter\/adv-filter\/AdInfoFilter\/getAdInfos(?:\?.*)?$/i && ${response.status} == 200 then response.json.jq(".body=[]")


[Script]
# 页面与轮播净化核心脚本（含 AES 动态解密、横幅轮播区整体移除与四大落地推广广告剔除）
response if ${url} ~= /^https:\/\/(?:client\.app\.coc\.10086\.cn\/biz-orange\/(?:DN\/(?:homePage\/getTopAreaList|myPageNew\/getMyPageNew|multipleInterfaces\/aggregationData|init\/getNavigation|searchWord\/getSearchWordInfo)|DA\/baseServiceFunction\/getAdverList)|h\.app\.coc\.10086\.cn\/biz-orange\/DA\/baseServiceFunction\/getAdverList)(?:\?.*)?$/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/cmcc/remove_ads.js?v=2026102310", {${HideCarousel}, ${HomeBasicClean}, ${ServicePageClean}, ${MineClean}, ${HideTopFamily}, ${HideTopAge}, ${HideTopPhone}, ${HideTopNearby}, ${HideTopAI}, ${HideTopEnterprise}, ${HideMyCheckIn}, ${HideMyMarketing}, ${HideMyServices}, ${HideMyFamilyCube}, ${HideMyDevicesCube}, ${HideMyMiniProgram}, ${HideMyDigitalHuman}, ${HideMySelections}, ${HideMyGroup}, ${HideMyRingtone}, ${HideMyCloudDrive}, ${HideMyToolbox}, ${HideMyLifeServices}}) with tag="[中国移动]页面与轮播净化", timeout=10, requires_body=true
response if ${url} ~= /^https:\/\/h\.app\.coc\.10086\.cn\/biz-orange\/DH\/(?:message_query\/message\/query\/list|myCardVoucher\/getBannerList)(?:\?.*)?$/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/cmcc/remove_ads.js?v=2026102310", {${HideCarousel}}) with tag="[中国移动]消息与卡券横幅净化", timeout=10, requires_body=true
response if ${url} ~= /^https:\/\/app\.10086\.cn\/biz-orange\/DA\/commonBoard\/getCommonBoard(?:\?.*)?$/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/cmcc/remove_ads.js?v=2026102310", {${HideCarousel}}) with tag="[中国移动]横幅看板净化", timeout=10, requires_body=true

[MITM]
hostname = client.app.coc.10086.cn, h.app.coc.10086.cn, app.10086.cn, ad.mcloud.139.com
