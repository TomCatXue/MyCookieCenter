#!name = 中国移动 · 移动爱家全方位净化增强
#!desc = 彻底净化启动页、首页轮播、移动爱家与智能专区、发现页视频/文章、我的钱包充话费与借钱卡片、信息流与弹窗浮窗，底层物理级移除广告组件；标准插件格式。
#!openUrl = https://apps.apple.com/app/id583700738
#!author = Yuheng0101, anker1209, ccyykk666, sooyaaabo; 轮播与专区全方位净化 TomCatXue
#!tag = 去广告, 中国移动, 移动爱家, 轮播净化
#!system = iOS,iPadOS
#!loon_version = 3.5.2(1005)
#!homepage = https://github.com/TomCatXue/MyCookieCenter
#!icon = https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/ChinaMobile.png
#!version = 1.1.0
#!date = 2026-10-23 01:45

# 核心升级说明（2026-10-23 v1.1.0）：
# 1. 首页与智能爱家专区轮播图物理级消除：底层 AES 接口剔除首页顶部轮播与 XBYYW 运营位横幅；移动爱家/智能专区剔除 Swiper 轮播图、Leaderboard 大图、标题栏右上角营销推广以及悬浮窗与触点弹窗。
# 2. 发现页短视频与文章全量净化：拦截 display-sc.miguvideo.com 动态接口，清空视频卡片、新闻资讯文章流与贴片广告，全面封禁 uem.migu.cn 性能监测。
# 3. 我的钱包与充话费专区深度净化：在 app.jf.10086.cn 接口中清空充话费下方轮播图、端AI推荐、一排二行爆品、T-优选卡（会员优享卡片）与猜你喜欢/精彩推荐信息流；在 /hePay/all 中清空移动钱包与借钱吧贷款推广卡片。
# 4. 全局 APM、埋点与风控数据物理级直拒：Rule 层面新增阻断神策/和包埋点 (uba.cmft.com.cn)、决策引擎 (yxfk.market.chinamobile.com)、移动APM、DFP设备指纹等 10 大上报通道，省电防追踪。

[Argument]
HideCarousel = switch,true,tag=[轮播] 彻底移除轮播图,desc=移除首页与各专区横幅轮播图组件及四大落地推广（办宽带/智盒/摄像头/融合套餐），使其彻底消失而非仅阻断跳转
HomeBasicClean = switch,true,tag=[首页] 基础净化,desc=清理首页瀑布流、推荐位与活动广告
ServicePageClean = switch,true,tag=[专区] 专区横幅净化,desc=清理话费/余量等业务专区横幅推广
MineClean = switch,true,tag=[我的] 基础净化,desc=清理「我的」页面营销区域、签到浮窗与推荐卡片
WalletClean = switch,true,tag=[钱包] 充话费与钱包净化,desc=清理我的钱包中充话费下方轮播图、借钱、会员优享卡片与精彩推荐信息流
DiscoverClean = switch,true,tag=[发现] 发现页短视频与文章净化,desc=清空发现页短视频信息流、大轮播图与新闻资讯模块
SmartPageClean = switch,true,tag=[智能] 移动爱家智能专区净化,desc=清理移动爱家/智能专区右上角广告、轮播大图、悬浮窗动效与营销触点弹窗
HideTopFamily = switch,false,tag=[首页] 隐藏-爱家,desc=隐藏首页顶部 Tab「爱家」
HideTopAge = switch,false,tag=[首页] 隐藏-网龄,desc=隐藏首页顶部 Tab「网龄」
HideTopPhone = switch,false,tag=[首页] 隐藏-手机,desc=隐藏首页顶部 Tab「手机」
HideTopNearby = switch,false,tag=[首页] 隐藏-附近厅,desc=隐藏首页顶部 Tab「附近厅」
HideTopAI = switch,false,tag=[首页] 隐藏-AI尝鲜,desc=隐藏首页顶部 Tab「AI 尝鲜」
HideTopEnterprise = switch,false,tag=[首页] 隐藏-政企,desc=隐藏首页顶部 Tab「政企」
HideMyCheckIn = switch,false,tag=[我的] 隐藏-签到浮窗,desc=隐藏「我的」签到浮窗（areaId 20230721008）
HideMyMarketing = switch,false,tag=[我的] 隐藏-营销区域,desc=隐藏「我的」营销区域（areaId 20230721012）
HideMyServices = switch,false,tag=[我的] 隐藏-我的服务,desc=隐藏「我的」我的服务（areaId 20230721018）
HideMyFamilyCube = switch,false,tag=[我的] 隐藏-我的家庭,desc=隐藏「我的」我的家庭（areaId 20240708002）
HideMyDevicesCube = switch,false,tag=[我的] 隐藏-我的设备,desc=隐藏「我的」我的设备（areaId 20251024002）
HideMyMiniProgram = switch,false,tag=[我的] 隐藏-我的账户,desc=隐藏「我的」我的账户（areaId 20231017002）
HideMyDigitalHuman = switch,false,tag=[我的] 隐藏-AI智能助理,desc=隐藏「我的」AI 智能助理（areaId 20230721020）
HideMySelections = switch,false,tag=[我的] 隐藏-我的优选,desc=隐藏「我的」我的优选（areaId 20230721030）
HideMyGroup = switch,false,tag=[我的] 隐藏-我的集团,desc=隐藏「我的」我的集团（areaId 20230721036）
HideMyRingtone = switch,false,tag=[我的] 隐藏-我的彩铃,desc=隐藏「我的」我的彩铃（areaId 20251230002）
HideMyCloudDrive = switch,false,tag=[我的] 隐藏-我的云盘,desc=隐藏「我的」我的云盘（areaId 20240624002）
HideMyToolbox = switch,false,tag=[我的] 隐藏-百宝箱,desc=隐藏「我的」百宝箱（areaId 20230721044）
HideMyLifeServices = switch,false,tag=[我的] 隐藏-生活服务,desc=隐藏「我的」生活服务（areaId 20230928004）

[Rule]
# APM 行为、性能监控、设备指纹与埋点日志上报拦截（底层物理级阻断，省电防追踪）
DOMAIN-SUFFIX, cmicapm.com, REJECT
DOMAIN-SUFFIX, dc.cmicapm.com, REJECT
DOMAIN-SUFFIX, jiguang.coc.10086.cn, REJECT
DOMAIN-SUFFIX, uba.cmft.com.cn, REJECT
DOMAIN-SUFFIX, yxfk.market.chinamobile.com, REJECT
DOMAIN-SUFFIX, uem.migu.cn, REJECT
DOMAIN-SUFFIX, da.mmarket.com, REJECT
DOMAIN-SUFFIX, dnlog.cmpassport.com, REJECT
DOMAIN-SUFFIX, log1.cmpassport.com, REJECT
DOMAIN-SUFFIX, dfp.cmft.com.cn, REJECT
DOMAIN-SUFFIX, mtm.online-cmcc.cn, REJECT
DOMAIN-SUFFIX, apm.app.coc.10086.cn, REJECT
DOMAIN-SUFFIX, apm.clientaccess.10086.cn, REJECT

[Rewrite]
# 开屏与基础广告规则秒拒拦截
request if ${url} ~= /^https?:\/\/(?:client\.app\.coc|app)\.10086\.cn\/biz-orange\/DN\/(?:explorePage\/getAdverList|init\/startInit|emotionMarket)(?:\?.*)?$/i then reject(200)
request if ${url} ~= /^https?:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/(?:DN\/(?:dropsAdverService\/getDropsAdverNew|homepagePopup\/getSortInfo|toast\/getToastRule|detainment\/august\/getPages)|DH\/(?:toast\/august\/(?:getToast|getPages)|message_query\/index\/getLatestPushMsg)|DA\/liveSuspension\/getPageCode|UN\/message\/pushMessage)(?:\?.*)?$/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/client\.app\.coc\.10086\.cn\/cache_server\/api\/cache\/encrypt\/reportV2(?:\?.*)?$/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/push\.it\.10086\.cn\/(?:contact\/(?:pull\/getUserActivityInfo|receipt\/activityReceipt)|mc\/pull\/pullDDpushMsgDetail)(?:\?.*)?$/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/app\.jf\.10086\.cn\/cmcc-h5-shop\/cms\/(?:advertisePosition|advertisePage)(?:\?.*)?$/i then reject_dict(200)
response if ${url} ~= /^https:\/\/ad\.mcloud\.139\.com\/advertapi\/adv-filter\/adv-filter\/AdInfoFilter\/getAdInfos(?:\?.*)?$/i && ${response.status} == 200 then response.json.jq(".body=[]")


[Script]
# 页面与轮播净化核心脚本（含 AES 动态解密、横幅轮播区整体移除、右上角广告清理与四大落地推广剔除）
response if ${url} ~= /^https:\/\/(?:client\.app\.coc\.10086\.cn\/biz-orange\/(?:DN\/(?:homePage\/getTopAreaList|myPageNew\/getMyPageNew|multipleInterfaces\/aggregationData|init\/getNavigation|searchWord\/getSearchWordInfo|titleBar\/getIcon)|DA\/baseServiceFunction\/getAdverList)|h\.app\.coc\.10086\.cn\/biz-orange\/DA\/baseServiceFunction\/getAdverList)(?:\?.*)?$/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/cmcc/remove_ads.js", {${HideCarousel}, ${HomeBasicClean}, ${ServicePageClean}, ${MineClean}, ${WalletClean}, ${DiscoverClean}, ${SmartPageClean}, ${HideTopFamily}, ${HideTopAge}, ${HideTopPhone}, ${HideTopNearby}, ${HideTopAI}, ${HideTopEnterprise}, ${HideMyCheckIn}, ${HideMyMarketing}, ${HideMyServices}, ${HideMyFamilyCube}, ${HideMyDevicesCube}, ${HideMyMiniProgram}, ${HideMyDigitalHuman}, ${HideMySelections}, ${HideMyGroup}, ${HideMyRingtone}, ${HideMyCloudDrive}, ${HideMyToolbox}, ${HideMyLifeServices}}) with tag="[中国移动]页面与轮播净化", timeout=10, requires_body=true
response if ${url} ~= /^https:\/\/h\.app\.coc\.10086\.cn\/biz-orange\/DH\/(?:message_query\/message\/query\/list|myCardVoucher\/getBannerList)(?:\?.*)?$/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/cmcc/remove_ads.js", {${HideCarousel}}) with tag="[中国移动]消息与卡券横幅净化", timeout=10, requires_body=true
response if ${url} ~= /^https:\/\/app\.10086\.cn\/biz-orange\/DA\/commonBoard\/getCommonBoard(?:\?.*)?$/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/cmcc/remove_ads.js", {${HideCarousel}}) with tag="[中国移动]横幅看板净化", timeout=10, requires_body=true

# 我的钱包与充话费专区净化（清空充话费下方轮播图、端AI推荐、爆品必抢、会员优享卡片、猜你喜欢信息流与借钱吧贷款卡片）
response if ${url} ~= /^https:\/\/app\.jf\.10086\.cn\/cmcc-h5-shop\/(?:cms\/(?:contents|yourFavorite)|hePay\/all)(?:\?.*)?$/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/cmcc/remove_ads.js", {${WalletClean}, ${HideCarousel}}) with tag="[中国移动]我的钱包与充话费净化", timeout=10, requires_body=true

# 发现页短视频、大轮播图与新闻资讯文章流净化
response if ${url} ~= /^https?:\/\/display-sc\.miguvideo\.com\/display\/v3\/static(?:\/.*)?$/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/cmcc/remove_ads.js", {${DiscoverClean}, ${HideCarousel}}) with tag="[中国移动]发现页视频与文章净化", timeout=10, requires_body=true

# 移动爱家与智能专区画布布局净化（剔除轮播图 Swiper、排行榜大图、悬浮窗动效与营销触点弹窗）
response if ${url} ~= /^https:\/\/res\.coc\.10086\.cn\/res\/cdn\/coc1\/fixedPath\/production\.rightsmarket-h5-canvas\.online\.layout\..*\.json(?:\?.*)?$/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/cmcc/remove_ads.js", {${SmartPageClean}, ${HideCarousel}}) with tag="[中国移动]智能专区与爱家画布净化", timeout=10, requires_body=true

# 陕西秦币专区凭据静默捕获与会话回填
request if ${url} ~= /^https?:\/\/sn\.clientaccess\.10086\.cn\/html5\/indivbusi\//i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/cmcc/cmcc_cookie.js?v=2026102201") with tag="[中国移动]陕西秦币凭据捕获", requires_body=true
response if ${url} ~= /^https?:\/\/sn\.clientaccess\.10086\.cn\/html5\/indivbusi\/(tokenLogin\/login|qinCoin\/)/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/cmcc/cmcc_cookie.js?v=2026102201") with tag="[中国移动]陕西秦币会话捕获", requires_body=true

[MITM]
hostname = client.app.coc.10086.cn, h.app.coc.10086.cn, app.10086.cn, ad.mcloud.139.com, sn.clientaccess.10086.cn, app.jf.10086.cn, display-sc.miguvideo.com, res.coc.10086.cn, push.it.10086.cn
