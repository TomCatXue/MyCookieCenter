#!name = 中国移动
#!desc = 净化开屏、首页轮播、专区横幅与「我的」弹窗。
#!openUrl = https://apps.apple.com/app/id583700738
#!author = Yuheng0101, anker1209, ccyykk666, sooyaaabo; 轮播净化 TomCatXue
#!tag = 去广告, 中国移动, 轮播净化
#!system = iOS,iPadOS
#!loon_version = 3.5.2(1005)
#!homepage = https://github.com/TomCatXue/MyCookieCenter
#!icon = https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/ce/b7/2c/ceb72c6e-21c3-0c8b-a960-2fb8a547279f/AppIcon-0-0-1x_U007epad-0-1-0-sRGB-85-220.png/512x512bb.jpg
#!version = 1.0.10
#!date = 2026-10-24 14:43

# 核心升级说明（2026-10-22 v1.0.3）：
# 1. 纯粹净屏与轮播消除：移除一切针对跳过支付 VPN 的多余网络规则，支付时请直接关闭 VPN 完成付款（iOS 端和包支付 SDK 在 Native 层扫描网络接口，开启代理时任何伪装规则均无效，关闭代理为唯一确定路径）。
# 2. 开关参数格式严谨化：严格遵循 Loon 标准 key = type,default,tag=...,desc=... 格式，剔除多余空格，彻底解决 Loon UI 切换开关时只能关闭不能打开的异常。
# 3. 轮播图物理级消除：在底层 AES 解密接口 (getAdverList / getTopAreaList) 中直接剔除「横幅轮播区」与四大目标推广，使前端轮播组件彻底消失而非仅阻断点击。
# 4. 开关业务代码双向联动：全量打通 27 个开关在核心脚本中的双向联动逻辑，确保每一个开关开启/关闭均精准生效。
# 5. 「我的」页按业务卡独立开关，营销内容固定关闭；开关名称与真实 areaId/cubeId 映射见脚本 v1.1.3。

[Argument]
HideCarousel = switch,true,tag=[轮播] 彻底移除轮播图,desc=移除首页与各专区横幅轮播图组件及四大落地推广（办宽带/智盒/摄像头/融合套餐），使其彻底消失而非仅阻断跳转
HomeBasicClean = switch,true,tag=[首页] 基础净化,desc=清理首页瀑布流、推荐位与活动广告
ServicePageClean = switch,true,tag=[专区] 专区横幅净化,desc=清理话费/余量等业务专区横幅推广
WalletClean = switch,true,tag=[钱包] 充话费与钱包净化,desc=清理我的钱包中充话费下方轮播图、借钱、会员优享卡片与精彩推荐信息流
DiscoverClean = switch,true,tag=[发现] 发现页短视频与文章净化,desc=清空发现页短视频信息流、大轮播图与新闻资讯模块
HideTopFamily = switch,false,tag=[首页] 隐藏-爱家,desc=隐藏首页顶部 Tab「爱家」
HideTopAge = switch,false,tag=[首页] 隐藏-网龄,desc=隐藏首页顶部 Tab「网龄」
HideTopPhone = switch,false,tag=[首页] 隐藏-手机,desc=隐藏首页顶部 Tab「手机」
HideTopNearby = switch,false,tag=[首页] 隐藏-附近厅,desc=隐藏首页顶部 Tab「附近厅」
HideTopAI = switch,false,tag=[首页] 隐藏-AI尝鲜,desc=隐藏首页顶部 Tab「AI 尝鲜」
HideTopEnterprise = switch,false,tag=[首页] 隐藏-政企,desc=隐藏首页顶部 Tab「政企」
HideMyHeaderEntry = switch,false,tag=[我的] 隐藏-标题栏服务入口,desc=隐藏「我的」标题栏服务入口（areaId 20230720006）
HideMyCheckIn = switch,false,tag=[我的] 隐藏-签到浮窗,desc=隐藏「我的」签到浮窗（areaId 20230721008）
HideMyServices = switch,false,tag=[我的] 隐藏-我的服务,desc=隐藏「我的」我的服务卡片（areaId 20230721018 / 20260104006）
HideMyFamilyCube = switch,false,tag=[我的] 隐藏-我的家庭,desc=隐藏「我的」我的家庭卡片（areaId 20240708002 / 20240429006）
HideMyDevicesCube = switch,false,tag=[我的] 隐藏-我的设备,desc=隐藏「我的」我的设备卡片（areaId 20251024002 / 20251016004）
HideMyMiniProgram = switch,false,tag=[我的] 隐藏-我的账户,desc=隐藏「我的」我的账户（areaId 20231017002）
HideMyDigitalHuman = switch,false,tag=[我的] 隐藏-AI智能助理,desc=隐藏「我的」AI 智能助理（areaId 20230721020）
HideMySelections = switch,false,tag=[我的] 隐藏-我的优选,desc=隐藏「我的」我的优选（areaId 20230721030）
HideMyGroup = switch,false,tag=[我的] 隐藏-我的集团,desc=隐藏「我的」我的集团（areaId 20230721036）
HideMyRingtone = switch,false,tag=[我的] 隐藏-我的彩铃,desc=隐藏「我的」我的彩铃（areaId 20251230002）
HideMyCloudDrive = switch,false,tag=[我的] 隐藏-我的云盘,desc=隐藏「我的」我的云盘（areaId 20240624002）
HideMyToolbox = switch,false,tag=[我的] 隐藏-百宝箱,desc=隐藏「我的」百宝箱（areaId 20230721044）
HideMyLifeServices = switch,false,tag=[我的] 隐藏-生活服务,desc=隐藏「我的」生活服务（areaId 20230928004 / 20240528002）
HideMyVideo = switch,false,tag=[我的] 隐藏-我的视频,desc=隐藏「我的」我的视频（areaId 20260423002）
HideMyExclusiveServices = switch,false,tag=[我的] 隐藏-我的专属服务,desc=隐藏「我的」我的专属服务（areaId 20260508004）
HideMyNewCall = switch,false,tag=[我的] 隐藏-新通话,desc=隐藏「我的」新通话卡片（areaId 20260610004）

[Rule]
# APM 行为与埋点日志上报拦截（物理级阻断，省电防追踪）
DOMAIN-SUFFIX, cmicapm.com, REJECT
DOMAIN-SUFFIX, dc.cmicapm.com, REJECT
DOMAIN-SUFFIX, jiguang.coc.10086.cn, REJECT
DOMAIN-SUFFIX, uba.cmft.com.cn, REJECT
DOMAIN-SUFFIX, yxfk.market.chinamobile.com, REJECT
DOMAIN-SUFFIX, uem.migu.cn, REJECT
DOMAIN-SUFFIX, da.mmarket.com, REJECT
DOMAIN-SUFFIX, dfp.cmft.com.cn, REJECT
DOMAIN-SUFFIX, mtm.online-cmcc.cn, REJECT
# 移动开屏广告底层物理级直拒（MCloud 广告聚合 SDK、腾讯优量汇、字节穿山甲）
DOMAIN, REJECT
DOMAIN-SUFFIX, gdt.qq.com, REJECT
DOMAIN-SUFFIX, e.qq.com, REJECT
DOMAIN-SUFFIX, pangolin-sdk-toutiao.com, REJECT
DOMAIN-SUFFIX, pglstatp-toutiao.com, REJECT
DOMAIN-SUFFIX, bytegoofy.com, REJECT

[Rewrite]
# 开屏与基础广告规则
request if ${url} ~= /^https?:\/\/(?:client\.app\.coc|app)\.10086\.cn\/biz-orange\/(?:DN|DA)\/(?:explorePage\/.*|init\/startInit|emotionMarket)(?:\?.*)?$/i then reject(200)
request if ${url} ~= /^https?:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/(?:DN\/(?:dropsAdver.*|homepagePopup\/getSortInfo|homePage\/getPopupInfo|toast\/.*|detainment\/.*)|DH\/(?:toast\/.*|detainment\/.*|facePopup\/.*|livePopup\/.*)|DA\/liveSuspension\/getPageCode)(?:\?.*)?$/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/app\.jf\.10086\.cn\/cmcc-h5-shop\/cms\/(?:advertisePosition|advertisePage|globalIcon)(?:\?.*)?$/i then reject_dict(200)


[Script]
# 页面与轮播净化核心脚本（含 AES 动态解密、横幅轮播区整体移除、右上角广告清理与四大落地推广广告剔除）
response if ${url} ~= /^https:\/\/(?:client\.app\.coc\.10086\.cn\/biz-orange\/(?:DN\/(?:homePage\/getTopAreaList|myPageNew\/getMyPageNew|multipleInterfaces\/aggregationData|init\/getNavigation|searchWord\/getSearchWordInfo|titleBar\/getIcon)|DA\/baseServiceFunction\/getAdverList)|h\.app\.coc\.10086\.cn\/biz-orange\/DA\/baseServiceFunction\/getAdverList)(?:\?.*)?$/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/cmcc/remove_ads.js?v=2026102413", {${HideCarousel}, ${HomeBasicClean}, ${ServicePageClean}, ${WalletClean}, ${DiscoverClean}, ${HideTopFamily}, ${HideTopAge}, ${HideTopPhone}, ${HideTopNearby}, ${HideTopAI}, ${HideTopEnterprise}, ${HideMyHeaderEntry}, ${HideMyCheckIn}, ${HideMyServices}, ${HideMyFamilyCube}, ${HideMyDevicesCube}, ${HideMyMiniProgram}, ${HideMyDigitalHuman}, ${HideMySelections}, ${HideMyGroup}, ${HideMyRingtone}, ${HideMyCloudDrive}, ${HideMyToolbox}, ${HideMyLifeServices}, ${HideMyVideo}, ${HideMyExclusiveServices}, ${HideMyNewCall}}) with tag="[中国移动]页面与轮播净化", timeout=10, requires_body=true
response if ${url} ~= /^https:\/\/h\.app\.coc\.10086\.cn\/biz-orange\/DH\/(?:message_query\/message\/query\/list|myCardVoucher\/getBannerList)(?:\?.*)?$/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/cmcc/remove_ads.js?v=2026102320", {${HideCarousel}}) with tag="[中国移动]消息与卡券横幅净化", timeout=10, requires_body=true
response if ${url} ~= /^https:\/\/app\.10086\.cn\/biz-orange\/DA\/commonBoard\/getCommonBoard(?:\?.*)?$/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/cmcc/remove_ads.js?v=2026102320", {${HideCarousel}}) with tag="[中国移动]横幅看板净化", timeout=10, requires_body=true

# 我的钱包与充话费专区净化（清空充话费下方轮播图、端AI推荐、爆品必抢、会员优享卡片、猜你喜欢信息流与借钱吧贷款卡片）
response if ${url} ~= /^https:\/\/app\.jf\.10086\.cn\/cmcc-h5-shop\/(?:cms\/(?:contents|yourFavorite)|hePay\/all)(?:\?.*)?$/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/cmcc/remove_ads.js?v=2026102320", {${WalletClean}, ${HideCarousel}}) with tag="[中国移动]我的钱包与充话费净化", timeout=10, requires_body=true

# 发现页短视频、大轮播图与新闻资讯文章流净化
response if ${url} ~= /^https?:\/\/display-sc\.miguvideo\.com\/display\/v3\/static(?:\/.*)?$/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/cmcc/remove_ads.js?v=2026102320", {${DiscoverClean}, ${HideCarousel}}) with tag="[中国移动]发现页视频与文章净化", timeout=10, requires_body=true

# 移动爱家与智能专区画布布局净化（剔除轮播图 Swiper、排行榜大图、悬浮窗动效与营销触点弹窗）
response if ${url} ~= /^https:\/\/res\.coc\.10086\.cn\/res\/cdn\/coc1\/fixedPath\/production\.rightsmarket-h5-canvas\.online\.layout\..*\.json(?:\?.*)?$/i then script("https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/cmcc/remove_ads.js?v=2026102320", {${HideCarousel}}) with tag="[中国移动]智能专区与爱家画布净化", timeout=10, requires_body=true

[MITM]
hostname = client.app.coc.10086.cn, h.app.coc.10086.cn, app.10086.cn, ad.mcloud.139.com, app.jf.10086.cn, display-sc.miguvideo.com, res.coc.10086.cn
