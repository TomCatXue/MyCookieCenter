      ],
      "repo": "https://github.com/TomCatXue/MyCookieCenter",
      "settings": [
        {
          "id": "weread_auth_v2",
          "name": "📋【青龙 WEREAD_AUTH】微信读书 App 完整凭证",
          "val": "",
          "type": "textarea",
          "autoGrow": true,
          "rows": 4,
          "desc": "包含 vid、skey、refreshToken、deviceId 的 JSON 数据。捕获后自动回显，点击上方脚本可一键复制"
        },
        {
          "id": "prefer_coin",
          "name": "阅读达标奖励偏好",
          "val": "2",
          "type": "selects",
          "items": [
            {
              "key": "1",
              "label": "优先领体验卡"
            },
            {
              "key": "2",
              "label": "优先领书币 (推荐)"
            }
          ],
          "desc": "每周阅读时长达标奖励偏好。设为优先书币时自动转换书币"
        }
      ],
      "descs_html": [
        "<span><b>💡 抓取黄金顺序：</b>建议先打开微信读书 App 进入<b>「我」</b>的页面（触发捕获 App 基础票据与脱机换票 token），再去打开<b>「周二翻牌」</b>活动页（自动补齐 Web 端 wr_vid / wr_skey）。两步结合即可自动合成最完整的满血凭据！</span>",
        "<span><b>📋 复制到青龙：</b>在下方<b>「当前会话」</b>数据列表点击 <code>weread_auth_v2</code> 这一行，弹出的<b>数据查看器</b>中该值右侧有<b>复制</b>按钮，即可整段复制并粘贴到青龙环境变量 <code>WEREAD_AUTH</code>。</span>",
        "<span><b>🗑️ 清空重抓：</b>如需重新抓取，点击卡片右上角 ⋮ ->「清除数据」即可（也可用数据行右侧的 ✕ 删除单项），随后重新进入 App 触发捕获。</span>"
      ]
    },
