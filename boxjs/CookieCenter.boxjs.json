        {
          "name": "每日阅读达标奖励自动领取",
          "cron": "0 23 * * *",
          "script": "https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/app/weread_claim/weread_claim.js"
        },
        {
          "name": "每周二翻牌抽奖自动运行",
          "cron": "0 20 * * 2",
          "script": "https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/app/weread_claim/weread_flip.js"
        },
        {
          "name": "每周限免好书自动入架",
