    {
      "id": "mycookiecenter.weread",
      "name": "微信读书",
      "keys": [
        "weread_auth_v2",
        "weread_clear",
        "prefer_coin"
      ],
      "author": "@TomCatXue",
      "icon": "https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/icons/weread.png?v=20261015",
      "icons": [
        "https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/icons/weread.png?v=20261015",
        "https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/icons/weread.png?v=20261015"
      ],
      "repo": "https://github.com/TomCatXue/MyCookieCenter",
      "scripts": [
        {
          "name": "📋 导出微信读书青龙凭据 (点此运行在日志全选复制)",
          "script": "https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/main/scripts/tools/boxjs/export_env.js"
        }
      ],
      "settings": [
        {
          "id": "weread_clear",
          "name": "清除 Cookie",
          "val": false,
          "type": "boolean",
          "desc": "设为开启后，点击上方导出脚本会安全重置已保存的微信读书凭证，完成后自动复位为关闭"
        },
        {
          "id": "weread_auth_v2",
          "name": "📋【青龙 WEREAD_AUTH】微信读书 App 完整凭证",
          "val": "",
          "type": "textarea",
          "autoGrow": true,
          "rows": 4,
          "desc": "包含 vid、skey、refreshToken、deviceId 的 JSON 数据。捕获后自动回显，点击上方脚本可一键复制"
        },
        {
          "id": "prefer_coin",
          "name": "阅读达标奖励偏好",
          "val": "2",
          "type": "selects",
          "items": [
            {
              "key": "1",
              "label": "优先领体验卡"
            },
            {
              "key": "2",
              "label": "优先领书币 (推荐)"
            }
          ],
          "desc": "每周阅读时长达标奖励偏好。设为优先书币时自动转换书币"
        }
      ],
      "descs_html": [
        "<span><b>💡 抓取黄金顺序：</b>建议先打开微信读书 App 进入<b>「我」</b>的页面（触发捕获 App 基础票据与脱机换票 token），再去打开<b>「周二翻牌」</b>活动页（自动补齐 Web 端 wr_vid / wr_skey）。两步结合即可自动合成最完整的满血凭据！</span>",
        "<span><b>📋 一键复制到青龙：</b>在上方【应用脚本】轻按 ▶️ 运行「导出微信读书青龙凭据」，界面将弹出日志抽屉层，轻触全选即可复制整行 <code>export WEREAD_AUTH='...'</code>。</span>",
        "<span><b>🗑️ 重置凭据：</b>如需重新抓取，将上方「清除 Cookie」开关开启并运行一次导出脚本即可。</span>"
      ]
    },
