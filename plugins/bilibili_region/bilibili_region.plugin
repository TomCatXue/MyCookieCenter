#!name = B站分区接口重写
#!desc = B站旧分区接口 /x/v2/channel/region/list 已 404，自动重写到新接口 /x/v2/region
#!author = TomCatXue
#!homepage = https://github.com/TomCatXue/MyCookieCenter
#!icon = https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/icons/bilibili.png
#!tag = 哔哩哔哩,接口重写

[MITM]
hostname = app.bilibili.com

[Script]
# 拦截旧分区接口，把路径从 /x/v2/channel/region/list 改为 /x/v2/region，query 参数原样保留
http-request ^https?://app\.bilibili\.com/x/v2/channel/region/list script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/plugins/bilibili_region/bilibili_region.js, requires-body=false, timeout=10
