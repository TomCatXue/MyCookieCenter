#!name = 微信读书VIP解锁
#!desc = v6.x会员解锁 + 付费墙 + 屏蔽更新
#!author = TomCatXue
#!homepage = https://github.com/TomCatXue/MyCookieCenter
#!icon = https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/icons/weread.png
#!tag = 微信读书,会员解锁,VIP

# ===== 独立开关 =====

[Argument]
vip_unlock = switch,true,tag=会员卡VIP,desc=会员摘要/登录/余额修改
chapter_fix = switch,true,tag=解锁阅读,desc=书籍信息+章节付费墙+阅读提示

# ===== MITM =====

[MITM]
hostname = i.weread.qq.com, weread.qq.com, api.unipay.qq.com, weread-1258476243.file.myqcloud.com

# ===== 脚本规则 =====

[Script]
# 会员/余额 (vip_unlock开关)
http-response ^https://i\.weread\.qq\.com/(login|pay/(memberCardSummary|membercardsummary|balance)|user/profile) tag=会员VIP, script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/plugins/weread_vip/weread_vip.js, requires-body=true, enable={vip_unlock}
http-response ^https://api\.unipay\.qq\.com/v1/r/ tag=会员VIP, script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/plugins/weread_vip/weread_vip.js, requires-body=true, enable={vip_unlock}

# 解锁阅读 (chapter_fix开关)
http-response ^https://i\.weread\.qq\.com/book/(chapterdownload|info|readinfo) tag=解锁阅读, script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/plugins/weread_vip/weread_vip.js, requires-body=true, enable={chapter_fix}
http-response ^https://i\.weread\.qq\.com/reader/(tips|report|welfareCoin) tag=解锁阅读, script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/plugins/weread_vip/weread_vip.js, requires-body=true, enable={chapter_fix}
http-response ^https://i\.weread\.qq\.com/readgift/card tag=解锁阅读, script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/plugins/weread_vip/weread_vip.js, requires-body=true, enable={chapter_fix}
http-response ^https://i\.weread\.qq\.com/(buyChapters|buyBook|careplan) tag=解锁阅读, script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/plugins/weread_vip/weread_vip.js, requires-body=true, enable={chapter_fix}

# 屏蔽更新 (始终开启)
http-response ^https://(i\.)?weread.*/(updateConfig|feconfig/getBundles|app/(update|version|config)) tag=屏蔽更新, script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/plugins/weread_vip/weread_vip.js, requires-body=true, enable=true
http-response ^https://weread.*\.file\.myqcloud\.com/app/(iap|config) tag=屏蔽更新, script-path=https://raw.githubusercontent.com/TomCatXue/MyCookieCenter/refs/heads/main/plugins/weread_vip/weread_vip.js, requires-body=true, enable=true
